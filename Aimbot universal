local function CleanupPlayerConnections(player)
    if PlayerConnections[player] then
        for _, conn in ipairs(PlayerConnections[player]) do
            pcall(function() conn:Disconnect() end)
        end
        table.clear(PlayerConnections[player])
    else
        PlayerConnections[player] = {}
    end

    local cacheData = CharacterCache[player]
    if cacheData then
        if cacheData.Chams then
            pcall(function() cacheData.Chams:Destroy() end)
            cacheData.Chams = nil
        end
        if cacheData.Character then
            for _, child in ipairs(cacheData.Character:GetChildren()) do
                if child.Name == "HkChams" and child:IsA("Highlight") then
                    pcall(function() child:Destroy() end)
                end
            end
        end
    end
end

local function BindCharacterCache(player, char)
    if not char then 
        local old = CharacterCache[player]
        if old and old.Chams then
            pcall(function() old.Chams:Destroy() end)
        end
        CharacterCache[player] = nil
        return 
    end

    for _, child in ipairs(char:GetChildren()) do
        if child.Name == "HkChams" and child:IsA("Highlight") then
            pcall(function() child:Destroy() end)
        end
    end

    local entry = {
        Character = char,
        Humanoid = char:FindFirstChildOfClass("Humanoid"),
        RootPart = char:FindFirstChild("HumanoidRootPart"),
        Head = char:FindFirstChild("Head"),
        Torso = char:FindFirstChild("Torso"),
        UpperTorso = char:FindFirstChild("UpperTorso"),
        LowerTorso = char:FindFirstChild("LowerTorso"),
        CurrentTool = char:FindFirstChildOfClass("Tool"),
        Chams = nil
    }
    
    CharacterCache[player] = entry

    local pConns = PlayerConnections[player]
    
    local cAdd = char.ChildAdded:Connect(function(child)
        if child:IsA("Humanoid") then entry.Humanoid = child
        elseif child.Name == "HumanoidRootPart" then entry.RootPart = child
        elseif child.Name == "Head" then entry.Head = child
        elseif child.Name == "Torso" then entry.Torso = child
        elseif child.Name == "UpperTorso" then entry.UpperTorso = child
        elseif child.Name == "LowerTorso" then entry.LowerTorso = child
        elseif child:IsA("Tool") then entry.CurrentTool = child
        elseif child.Name == "HkChams" and child:IsA("Highlight") then 
            if entry.Chams and entry.Chams ~= child then
                pcall(function() entry.Chams:Destroy() end)
            end
            entry.Chams = child 
        end
    end)
    
    local cRem = char.ChildRemoved:Connect(function(child)
        if child == entry.CurrentTool then entry.CurrentTool = char:FindFirstChildOfClass("Tool")
        elseif child == entry.Chams then entry.Chams = nil
        end
    end)

    table.insert(pConns, cAdd)
    table.insert(pConns, cRem)
end

local function SetupPlayerLifecycle(player)
    CleanupPlayerConnections(player)
    
    if player.Character then
        BindCharacterCache(player, player.Character)
    end

    local cAdded = player.CharacterAdded:Connect(function(char)
        BindCharacterCache(player, char)
    end)
    
    local cRemoving = player.CharacterRemoving:Connect(function()
        local cacheData = CharacterCache[player]
        if cacheData and cacheData.Chams then
            pcall(function() cacheData.Chams:Destroy() end)
        end
        CharacterCache[player] = nil
    end)

    table.insert(PlayerConnections[player], cAdded)
    table.insert(PlayerConnections[player], cRemoving)
end

for _, p in ipairs(Players:GetPlayers()) do
    SetupPlayerLifecycle(p)
end

RefreshActivePlayersList()

table.insert(Connections, Players.PlayerAdded:Connect(function(p)
    RefreshActivePlayersList()
