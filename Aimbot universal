_G.HkDrawingCache = {}
local function GetESP(player)
    if not hasDrawing then return nil end
    if not _G.HkDrawingCache[player] then
        _G.HkDrawingCache[player] = {
            Box = Drawing.new("Square"), Tracer = Drawing.new("Line"),
            Name = Drawing.new("Text"), Dist = Drawing.new("Text"),
            Skeleton = {
                Drawing.new("Line"), Drawing.new("Line"), Drawing.new("Line"), 
                Drawing.new("Line"), Drawing.new("Line"), Drawing.new("Line")
            }
        }
        local esp = _G.HkDrawingCache[player]
        esp.Box.Thickness = 1; esp.Box.Filled = false
        esp.Tracer.Thickness = 1
        esp.Name.Size = 14; esp.Name.Center = true; esp.Name.Outline = true
        esp.Dist.Size = 12; esp.Dist.Center = true; esp.Dist.Outline = true
        for _, line in pairs(esp.Skeleton) do line.Thickness = 1 end
    end
    return _G.HkDrawingCache[player]
end

local function ClearESP(esp)
    if not esp then return end
    if esp.Box then esp.Box.Visible = false end
    if esp.Tracer then esp.Tracer.Visible = false end
    if esp.Name then esp.Name.Visible = false end
    if esp.Dist then esp.Dist.Visible = false end
    if esp.Skeleton then for _, line in pairs(esp.Skeleton) do line.Visible = false end end
end

