CreateButton(tabSettings, "Cargar Config", function()
    if not hasFileAPI or not isfile("HkStudioConfig.json") then Notify("Settings", "No hay configuración guardada.") return end
    local success = pcall(function()
        local data = readfile("HkStudioConfig.json")
        local decoded = HttpService:JSONDecode(data)
        for cat, v in pairs(decoded) do
            if Config[cat] then
                for k, val in pairs(v) do
                    Config[cat][k] = val
                end
            end
        end
    end)
    if success then Notify("Settings", "Configuración cargada.") else Notify("Settings", "Error al cargar.") end
end)

