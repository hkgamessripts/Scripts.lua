local function GetPlayerTeamName(player)
    local now = os.clock()
    if TeamCache[player] and (now - (TeamCacheExpiry[player] or 0)) < 2.0 then
        return TeamCache[player]
    end

    local result = nil
    if player.Team then 
        result = player.Team.Name 
    else
        local attributes = {"Team", "Faction", "Role", "Job", "Equipo", "Rol"}
        local cacheData = CharacterCache[player]
        for _, attr in ipairs(attributes) do
            local val = player:GetAttribute(attr) or (cacheData and cacheData.Character and cacheData.Character:GetAttribute(attr))
            if val then 
                result = tostring(val) 
                break 
            end
        end
    end

    TeamCache[player] = result
    TeamCacheExpiry[player] = now
    return result
end

local function AreFactionsAllied(teamA, teamB)
    if not teamA or not teamB then return false end
    local key = teamA:lower() .. "_" .. teamB:lower()
    if AllianceCache[key] ~= nil then return AllianceCache[key] end

    if teamA:lower() == teamB:lower() then
        AllianceCache[key] = true
        return true
    end

    for _, allianceGroup in ipairs(FactionAlliances) do
        local inA, inB = false, false
        for _, member in ipairs(allianceGroup) do
            if teamA:lower():find(member) then inA = true end
            if teamB:lower():find(member) then inB = true end
        end
        if inA and inB then
            AllianceCache[key] = true
            return true
        end
    end

    AllianceCache[key] = false
    return false
end

local function IsTeammate(player)
    if not Config.Aimbot.TeamCheck then return false end
    if player == LocalPlayer then return true end
    
    local myTeam = GetPlayerTeamName(LocalPlayer)
    local targetTeam = GetPlayerTeamName(player)

    if myTeam and targetTeam and AreFactionsAllied(myTeam, targetTeam) then 
        return true 
    end

    if LocalPlayer.Team and player.Team and LocalPlayer.Team == player.Team then
        return true
    end

    return false
end

local function IsVisible(targetPart, player)
    if not Config.Aimbot.WallCheck then return true end
    if not targetPart or not targetPart.Parent or not targetPart:IsDescendantOf(workspace) then return false end
    
    if VisibilityFrameCache[targetPart] ~= nil then
        return VisibilityFrameCache[targetPart]
    end

    local now = os.clock()
    if player and VisibilityTimeCache[player] and (now - VisibilityTimeCache[player]) < 0.15 then
        if VisibilityResultCache[player] ~= nil then
            return VisibilityResultCache[player]
        end
    end

    local camPos = Camera.CFrame.Position
    local targetPos = targetPart.Position
    
    VisibilityRaycastParams.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    local rayResult = workspace:Raycast(camPos, targetPos - camPos, VisibilityRaycastParams)
    local visible = true
    
    if rayResult and rayResult.Instance then
        if not rayResult.Instance:IsDescendantOf(targetPart.Parent) then
            visible = false
        end
    end
    
    if player then
        VisibilityTimeCache[player] = now
        VisibilityResultCache[player] = visible
    end

    VisibilityFrameCache[targetPart] = visible
    return visible
end

