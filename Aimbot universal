local function GetPlayerTeamName(player)
    if player.Team then return player.Team.Name end
    local attrs = {"Team", "Faction", "Role", "Job", "Trabajo", "Equipo", "Rol"}
    for _, attr in ipairs(attrs) do
        local val = player:GetAttribute(attr) or (player.Character and player.Character:GetAttribute(attr))
        if val then return tostring(val) end
    end
    local ls = player:FindFirstChild("leaderstats")
    if ls then
        for _, attr in ipairs(attrs) do
            local val = ls:FindFirstChild(attr) or player:FindFirstChild(attr)
            if val and val:IsA("ValueBase") then return tostring(val.Value) end
        end
    end
    return nil
end

local function IsTeammate(player)
    if not Config.Aimbot.TeamCheck then return false end
    if player == LocalPlayer then return true end
    local myTeam, tTeam = GetPlayerTeamName(LocalPlayer), GetPlayerTeamName(player)
    if myTeam and tTeam then
        if myTeam:lower() == tTeam:lower() then return true end
    end
    return LocalPlayer.Team ~= nil and player.Team ~= nil and LocalPlayer.TeamColor == player.TeamColor
end

local function IsSafeDestination(cframe)
    local pos = cframe.Position
    if math.abs(pos.X) > 100000 or math.abs(pos.Z) > 100000 or pos.Y < -500 then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true
    if LocalPlayer.Character then params.FilterDescendantsInstances = {LocalPlayer.Character} end
    local ray = workspace:Raycast(pos + Vector3.new(0, 5, 0), Vector3.new(0, -50, 0), params)
    return ray ~= nil
end

local function IsVisible(targetPart)
    if not Config.Aimbot.WallCheck then return true end
    if not targetPart or not targetPart.Parent then return false end
    
    local currentClock = os.clock()
    if (currentClock - LastVisibilityClock) > 0.05 then
        table.clear(VisibilityCache)
        LastVisibilityClock = currentClock
    end
    if VisibilityCache[targetPart] ~= nil then
        return VisibilityCache[targetPart]
    end

    local camPos = Camera.CFrame.Position
    local targetPos = targetPart.Position
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true
    params.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    
    local success, result = pcall(function()
        return workspace:Raycast(camPos, targetPos - camPos, params)
    end)
    
    local visible = true
    if success and result then
        local hitInstance = result.Instance
        if hitInstance and not hitInstance:IsDescendantOf(targetPart.Parent) then
            visible = false
        end
    end
    VisibilityCache[targetPart] = visible
    return visible
end

