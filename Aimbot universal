-- ----------------------------------------------------
-- THREAD A: HEARTBEAT (ESP & Sincronización optimizada)
-- ----------------------------------------------------
table.insert(Connections, RunService.Heartbeat:Connect(function()
    if Unloaded then return end

    if #ActivePlayersList ~= #Players:GetPlayers() then
        RefreshActivePlayersList()
    end

    CurrentFrameId = CurrentFrameId + 1
    table.clear(VisibilityFrameCache)

    local activeColor = Config.Visuals.Rainbow and Color3.fromHSV(time() % 3 / 3, 0.8, 1) or ThemeColor
    local mousePos = UserInputService:GetMouseLocation()
    
    local shortestDist = Config.Aimbot.FOV
    local bestTarget = nil

    for _, player in ipairs(ActivePlayersList) do
        if player ~= LocalPlayer then
            local cache = CharacterCache[player]
            local esp = GetESP(player)
            
            if cache and cache.Character and cache.RootPart and cache.Head and cache.Humanoid then
                local root = cache.RootPart
                local head = cache.Head
                local hum = cache.Humanoid
                local isTeammate = IsTeammate(player)
                
                if cache.Chams then 
                    cache.Chams.Enabled = Config.Visuals.Chams and not isTeammate 
                    if not cache.Chams.Enabled and not Config.Visuals.Chams then
                        pcall(function() cache.Chams:Destroy() end)
                        cache.Chams = nil
                    end
                elseif Config.Visuals.Chams and not isTeammate then
                    local hl = Instance.new("Highlight", cache.Character)
                    hl.Name = "HkChams"
                    hl.FillColor = EnemyColor
                    cache.Chams = hl
                end

                if hum.Health > 0 and not isTeammate then
                    local vector, onScreen = Camera:WorldToViewportPoint(root.Position)
                    local physDist = math.floor((Camera.CFrame.Position - root.Position).Magnitude)

                    if onScreen and hasDrawing and physDist <= 300 then
                        local distFromCenter = (Vector2.new(vector.X, vector.Y) - mousePos).Magnitude

                        if Config.Visuals.Box and esp and esp.Box then
                            local headV = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                            local legV = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
                            local boxH = math.abs(headV.Y - legV.Y)
                            esp.Box.Size = Vector2.new(boxH * 0.6, boxH)
                            esp.Box.Position = Vector2.new(headV.X - (esp.Box.Size.X / 2), headV.Y)
                            esp.Box.Color = activeColor
                            esp.Box.Visible = true
                        elseif esp and esp.Box then esp.Box.Visible = false end

                        if Config.Visuals.Tracers and esp and esp.Tracer then
                            esp.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                            esp.Tracer.To = Vector2.new(vector.X, vector.Y)
                            esp.Tracer.Color = activeColor
                            esp.Tracer.Visible = true
                        elseif esp and esp.Tracer then esp.Tracer.Visible = false end

                        if Config.Visuals.Info and esp and esp.Name and esp.Dist then
                            esp.Name.Text = player.Name
                            esp.Name.Position = Vector2.new(vector.X, vector.Y - 20)
                            esp.Name.Color = TextWhite
                            esp.Name.Visible = true
                            
                            local tool = cache.CurrentTool
                            esp.Dist.Text = tool and (tool.Name .. " ["..physDist.."m]") or "["..physDist.."m]"
                            esp.Dist.Position = Vector2.new(vector.X, vector.Y + 20)
                            esp.Dist.Color = tool and EnemyColor or Color3.fromRGB(150,150,150)
                            esp.Dist.Visible = true
                        elseif esp and esp.Name and esp.Dist then
                            esp.Name.Visible = false
                            esp.Dist.Visible = false
                        end

                        local targetPartName = Config.Aimbot.TargetPart
                        local aimPart = (targetPartName == "Head" and head) or root
                        
                        if distFromCenter < shortestDist and aimPart then
                            if IsVisible(aimPart, player) then
                                shortestDist = distFromCenter
                                bestTarget = aimPart
                            end
                        end
                    else
                        ClearESP(esp)
                    end
                else
                    ClearESP(esp)
                end
            else
                ClearESP(esp)
            end
        end
    end

    currentBestTargetPart = bestTarget
end))

-- ----------------------------------------------------
-- THREAD B: RENDERSTEPPED (Cámara sin Jitter / Anti-Fight)
-- ----------------------------------------------------
table.insert(Connections, RunService.RenderStepped:Connect(function(dt)
    if Unloaded then return end

    local mousePos = UserInputService:GetMouseLocation()
    if hasDrawing and _G.HkFovCircle then
        _G.HkFovCircle.Position = mousePos
        _G.HkFovCircle.Radius = Config.Aimbot.FOV
        _G.HkFovCircle.Visible = Config.Aimbot.Enabled
    end

    if Config.Aimbot.Enabled and isAiming then
        if lockedTargetPart then
            local targetChar = lockedTargetPart.Parent
            local targetPlayer = targetChar and Players:GetPlayerFromCharacter(targetChar)
            local cache = targetPlayer and CharacterCache[targetPlayer]
            
            if not (cache and cache.Humanoid and cache.Humanoid.Health > 0 and IsVisible(lockedTargetPart, targetPlayer) and not IsTeammate(targetPlayer)) then
                lockedTargetPart = nil
            end
        end

        if not lockedTargetPart then
            lockedTargetPart = currentBestTargetPart
        end

        if lockedTargetPart and lockedTargetPart.Parent then
            local targetChar = lockedTargetPart.Parent
            local targetPlayer = Players:GetPlayerFromCharacter(targetChar)
            local cache = targetPlayer and CharacterCache[targetPlayer]

            if cache and cache.Humanoid and targetPlayer then
                targetNameLbl.Text = targetPlayer.Name
                local healthPct = math.clamp(cache.Humanoid.Health / cache.Humanoid.MaxHealth, 0, 1)
                targetHealthFill.Size = UDim2.new(healthPct, 0, 1, 0)
                targetHealthText.Text = math.floor(cache.Humanoid.Health) .. " HP"
                TargetHudFrame.Position = UDim2.new(0, mousePos.X + Config.Aimbot.FOV + 15, 0, mousePos.Y - 24)
                TargetHudFrame.Visible = true
            end

            local targetPos = lockedTargetPart.Position
            if Config.Aimbot.Predict and cache and cache.RootPart then
                local dist = (targetPos - Camera.CFrame.Position).Magnitude
                targetPos = targetPos + (cache.RootPart.AssemblyLinearVelocity * (dist / 1500))
            end

            local currentPos = Camera.CFrame.Position
            local targetCFrame = CFrame.lookAt(currentPos, targetPos)
            local alpha = math.clamp(dt * (11 - Config.Aimbot.Smoothness), 0.05, 1)
            Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, alpha)
        else
            TargetHudFrame.Visible = false
        end
    else
        TargetHudFrame.Visible = false
        lockedTargetPart = nil
    end
end))

