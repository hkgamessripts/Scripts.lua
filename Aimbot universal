        for _, pName in ipairs(parts) do
            local p = char:FindFirstChild(pName)
            if p then 
                OriginalTransparencies[pName] = p.Transparency
                p.Transparency = 1 
            end
        end
    else
        for _, pName in ipairs(parts) do
            local p = char:FindFirstChild(pName)
            if p and OriginalTransparencies[pName] then p.Transparency = OriginalTransparencies[pName] end
        end
    end
