CreateToggle(tabLocal, "BoostFPS (Engine Optimization)", "Local", "BoostFPS", true, function(state)
    if state then
        table.clear(OriginalMaterials)
        
        task.spawn(function()
            local queue = {workspace}
            local count = 0
            
            while #queue > 0 and Config.Local.BoostFPS and not Unloaded do
                local current = table.remove(queue, 1)
                
                for _, child in ipairs(current:GetChildren()) do
                    if not Config.Local.BoostFPS or Unloaded then break end
                    
                    if child:IsA("BasePart") then
                        local modelParent = child:FindFirstAncestorOfClass("Model")
                        local isPlayerChar = modelParent and Players:GetPlayerFromCharacter(modelParent) ~= nil
                        
                        if not isPlayerChar then
                            OriginalMaterials[child] = child.Material
                            child.Material = Enum.Material.SmoothPlastic
                        end
                    end
                    
                    if #child:GetChildren() > 0 then
                        table.insert(queue, child)
                    end
                    
                    count = count + 1
                    if count >= 300 then
                        count = 0
                        task.defer(task.wait)
                    end
                end
            end
        end)

        if not BoostFPSConnection then
            BoostFPSConnection = workspace.DescendantAdded:Connect(function(obj)
                if Config.Local.BoostFPS and obj:IsA("BasePart") then
                    local modelParent = obj:FindFirstAncestorOfClass("Model")
                    local isPlayerChar = modelParent and Players:GetPlayerFromCharacter(modelParent) ~= nil
                    
                    if not isPlayerChar then
                        OriginalMaterials[obj] = obj.Material
                        obj.Material = Enum.Material.SmoothPlastic
                    end
                end
            end)
            table.insert(Connections, BoostFPSConnection)
        end

        Notify("Optimizador", "BoostFPS activado de forma segura.")
    else
        for obj, mat in pairs(OriginalMaterials) do
            if obj and obj.Parent then
                obj.Material = mat
            end
        end
        table.clear(OriginalMaterials)
        if BoostFPSConnection then
            pcall(function() BoostFPSConnection:Disconnect() end)
            BoostFPSConnection = nil
        end
        Notify("Optimizador", "BoostFPS desactivado (Materiales restaurados).")
    end
end)

