CreateToggle(tabLocal, "BoostFPS (Limpiar Mapa)", "Local", "BoostFPS", true, function(state)
    if state then
        task.spawn(function()
            local count = 0
            for _, v in ipairs(workspace:GetDescendants()) do
                if Unloaded then break end
                if v:IsA("BasePart") then
                    OriginalMaterials[v] = v.Material
                    v.Material = Enum.Material.SmoothPlastic
                elseif v:IsA("Decal") then
                    OriginalDecalTransparencies[v] = v.Transparency
                    v.Transparency = 1
                elseif v:IsA("Texture") then
                    OriginalTextureTransparencies[v] = v.Transparency
                    v.Transparency = 1
                end
                count = count + 1
                if count % 600 == 0 then task.wait() end
            end
        end)
    else
        task.spawn(function()
            local count = 0
            for part, mat in pairs(OriginalMaterials) do
                if part and part.Parent then part.Material = mat end
                count = count + 1
                if count % 600 == 0 then task.wait() end
            end
            table.clear(OriginalMaterials)
            
            for decal, trans in pairs(OriginalDecalTransparencies) do
                if decal and decal.Parent then decal.Transparency = trans end
            end
            table.clear(OriginalDecalTransparencies)

            for tex, trans in pairs(OriginalTextureTransparencies) do
                if tex and tex.Parent then tex.Transparency = trans end
            end
            table.clear(OriginalTextureTransparencies)
        end)
    end
end)

local function ApplyKorblox(state)
    local char = LocalPlayer.Character
    if not char then return end
    local legParts = {"RightUpperLeg", "RightLowerLeg", "RightFoot", "RightLeg"}
    for _, pName in ipairs(legParts) do
        local p = char:FindFirstChild(pName)
        if p then
            if state then
                if OriginalTransparencies[pName] == nil then
                    OriginalTransparencies[pName] = p.Transparency
                end
                p.Transparency = 1
            else
                if OriginalTransparencies[pName] then
                    p.Transparency = OriginalTransparencies[pName]
                end
            end
        end
    end
end

CreateToggle(tabLocal, "Fake Korblox", "Local", "FakeKorblox", true, function(state)
    ApplyKorblox(state)
end)

