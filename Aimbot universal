-- Clasificador de facciones por palabras clave
local function GetFactionGroup(teamName)
    if not teamName or type(teamName) ~= "string" then return nil end
    local lowerName = teamName:lower()

    for i = 1, #LAW_KEYWORDS do
        if lowerName:find(LAW_KEYWORDS[i]) then return "law" end
    end
    for i = 1, #OUTLAW_KEYWORDS do
        if lowerName:find(OUTLAW_KEYWORDS[i]) then return "outlaw" end
    end
    return nil
end

-- Lector multi-origen de nombre de equipo
local function GetPlayerTeamName(player)
    -- 1. game.Teams estándar
    if player.Team then return player.Team.Name end

    -- 2. Attributes en Player
    local attr = player:GetAttribute("Team") or player:GetAttribute("Faction") or player:GetAttribute("Role")
    if attr then return tostring(attr) end

    -- 3. Attributes en Character
    if player.Character then
        local charAttr = player.Character:GetAttribute("Team") or player.Character:GetAttribute("Faction")
        if charAttr then return tostring(charAttr) end
    end

    -- 4. Values en Player / leaderstats
    local teamVal = player:FindFirstChild("Team") or player:FindFirstChild("Faction")
    if teamVal and teamVal:IsA("ValueBase") then return tostring(teamVal.Value) end

    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        local lTeam = leaderstats:FindFirstChild("Team") or leaderstats:FindFirstChild("Faction") or leaderstats:FindFirstChild("Role")
        if lTeam and lTeam:IsA("ValueBase") then return tostring(lTeam.Value) end
    end

    return nil
end

-- Evaluador principal de equipo
local function IsTeammate(player)
    if not Settings.TeamCheck then return false end
    if player == LocalPlayer then return true end

    -- Capa 0: Si alguno es Neutral por propiedad nativa, NO son equipo (Modo Libre / FFA)
    if player.Neutral or LocalPlayer.Neutral then
        return false
    end

    -- Capa 1: Análisis multi-origen de nombres de equipo
    local myTeamName = GetPlayerTeamName(LocalPlayer)
    local targetTeamName = GetPlayerTeamName(player)

    if myTeamName and targetTeamName then
        -- Coincidencia directa de nombre
        if myTeamName:lower() == targetTeamName:lower() then
            return true
        end

        -- Coincidencia por facción inteligente (Ej. Policía y Ejército)
        local myFaction = GetFactionGroup(myTeamName)
        local targetFaction = GetFactionGroup(targetTeamName)

        if myFaction and targetFaction and myFaction == targetFaction then
            return true
        end
    end

    -- Capa 2: Fallback por TeamColor (SOLO si ambos tienen un equipo activo en game.Teams)
    if LocalPlayer.Team ~= nil and player.Team ~= nil then
        if LocalPlayer.TeamColor == player.TeamColor then
            return true
        end
    end

    return false
end

-- Chequeo exclusivo de inmunidad (No afecta al ESP, solo al Aimbot)
local function IsInvulnerable(player)
    if not player.Character then return false end
    return player.Character:FindFirstChildOfClass("ForceField") ~= nil
end

