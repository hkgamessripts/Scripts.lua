CreateToggle(tabLocal, "Fake Headless", "Local", "FakeHeadless", true, function(state)
    local char = LocalPlayer.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if head then
        if state then
            OriginalTransparencies["Head"] = head.Transparency
            head.Transparency = 1
            local face = head:FindFirstChild("face")
            if face then
                OriginalTransparencies["Face"] = face.Transparency
                face.Transparency = 1
            end
        else
            head.Transparency = OriginalTransparencies["Head"] or 0
            local face = head:FindFirstChild("face")
            if face then face.Transparency = OriginalTransparencies["Face"] or 0 end
        end
    end
end)

CreateDropdown(tabLocal, "Teleport a Jugador", 
    function()
        local list = {}
        for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer then table.insert(list, p) end end
        return list
    end, 
    function(selectedPlayer)
        if not CheckCooldown("Teleport", 1) then return end
        if selectedPlayer.Character and selectedPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local targetCFrame = selectedPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
            if IsSafeDestination(targetCFrame) then
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    char:PivotTo(targetCFrame)
                    Notify("Teleport", "Teletransportado a " .. selectedPlayer.Name)
                end
            else
                Notify("Teleport", "Destino bloqueado o inseguro.")
            end
        end
    end
)

