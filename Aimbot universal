-- Sistema para Arrastrar el HUD de FPS
local draggingHud, dragInput, dragStart, startPos
topHud.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        draggingHud = true
        dragStart = input.Position
        startPos = topHud.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                draggingHud = false
            end
        end)
    end
end)
topHud.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then dragInput = input end
end)
UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and draggingHud then
        local delta = input.Position - dragStart
        topHud.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

