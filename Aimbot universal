local function CreateDropdown(parent, text, getOptionsCallback, onSelectCallback)
    local btn = CreateButton(parent, text .. " ▼", function() end)
    
    local listFrame = Instance.new("ScrollingFrame", hkGui)
    listFrame.Size = UDim2.new(0, 150, 0, 120)
    listFrame.BackgroundColor3 = BgLight
    listFrame.Visible = false
    listFrame.ZIndex = 10
    listFrame.ScrollBarThickness = 2
    Instance.new("UICorner", listFrame).CornerRadius = UDim.new(0, 6)
    local listStroke = Instance.new("UIStroke", listFrame)
    listStroke.Color = ThemeColor
    
    local layout = Instance.new("UIListLayout", listFrame)
    layout.Padding = UDim.new(0, 2)
    
    btn.MouseButton1Click:Connect(function()
        listFrame.Visible = not listFrame.Visible
        if listFrame.Visible then
            listFrame.Position = UDim2.new(0, btn.AbsolutePosition.X, 0, btn.AbsolutePosition.Y + btn.AbsoluteSize.Y + 5)
            for _, v in pairs(listFrame:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
            local options = getOptionsCallback()
            for _, opt in ipairs(options) do
                local item = Instance.new("TextButton", listFrame)
                item.Size = UDim2.new(1, 0, 0, 25)
                item.BackgroundTransparency = 1
                item.Text = opt.Name
                item.TextColor3 = TextWhite
                item.Font = Enum.Font.Gotham
                item.TextSize = 12
                item.ZIndex = 11
                item.MouseButton1Click:Connect(function()
                    listFrame.Visible = false
                    btn.Text = "TP: " .. opt.Name .. " ▼"
                    onSelectCallback(opt)
                end)
            end
        end
    end)

    -- Cerrar dropdown al hacer clic fuera
    table.insert(Connections, UserInputService.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 and listFrame.Visible then
            local mPos = UserInputService:GetMouseLocation()
            local absPos = listFrame.AbsolutePosition
            local absSize = listFrame.AbsoluteSize
            local btnPos = btn.AbsolutePosition
            local btnSize = btn.AbsoluteSize
            
            local inList = (mPos.X >= absPos.X and mPos.X <= absPos.X + absSize.X and mPos.Y >= absPos.Y and mPos.Y <= absPos.Y + absSize.Y)
            local inBtn = (mPos.X >= btnPos.X and mPos.X <= btnPos.X + btnSize.X and mPos.Y >= btnPos.Y and mPos.Y <= btnPos.Y + btnSize.Y)
            
            if not inList and not inBtn then
                listFrame.Visible = false
            end
        end
    end))
end

