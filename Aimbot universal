local fovCircle = nil
if hasDrawing then
    pcall(function()
        fovCircle = Drawing.new("Circle")
        fovCircle.Visible = false
        fovCircle.Filled = false
        fovCircle.Thickness = 1
        fovCircle.Color = ThemeColor
        fovCircle.Transparency = 0.8
        _G.HkFovCircle = fovCircle
    end)
end

local function GetClosestTarget()
    local bestTarget = nil
    local bestPlayer = nil
    local shortestDist = Config.Aimbot.FOV
    local mousePos = UserInputService:GetMouseLocation()

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and not IsTeammate(player) then
            local char = player.Character
            if char then
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                if humanoid and humanoid.Health > 0 then
                    local targetPart = char:FindFirstChild(Config.Aimbot.TargetPart)
                    if targetPart then
                        if IsVisible(targetPart) then
                            local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                            if onScreen then
                                local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                                if dist < shortestDist then
                                    shortestDist = dist
                                    bestTarget = targetPart
                                    bestPlayer = player
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return bestTarget, bestPlayer
end

table.insert(Connections, RunService.RenderStepped:Connect(function()
    local mousePos = UserInputService:GetMouseLocation()

    -- Actualizar Círculo FOV
    if fovCircle then
        if Config.Aimbot.Enabled then
            fovCircle.Visible = true
            fovCircle.Radius = Config.Aimbot.FOV
            fovCircle.Position = mousePos
            fovCircle.Color = ThemeColor
        else
            fovCircle.Visible = false
        end
    end

    if not Config.Aimbot.Enabled then
        TargetHudFrame.Visible = false
        return
    end

    local targetPart, targetPlayer = GetClosestTarget()

    if targetPart and targetPlayer then
        -- Actualizar Target HUD
        TargetHudFrame.Visible = true
        targetNameLbl.Text = targetPlayer.Name
        local char = targetPlayer.Character
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            local healthPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
            targetHealthFill.Size = UDim2.new(healthPercent, 0, 1, 0)
            targetHealthText.Text = math.floor(healthPercent * 100) .. "%"
        end

        -- Lógica de Aim
        local targetPos = targetPart.Position
        if Config.Aimbot.Predict and targetPart.AssemblyLinearVelocity then
            targetPos = targetPos + (targetPart.AssemblyLinearVelocity * (Camera.CFrame.Position - targetPos).Magnitude / Config.Aimbot.PredictionMultiplier)
        end

        local currentCamCFrame = Camera.CFrame
        local targetCFrame = CFrame.new(currentCamCFrame.Position, targetPos)
        
        if Config.Aimbot.Smoothness <= 1 then
            Camera.CFrame = targetCFrame
        else
            Camera.CFrame = currentCamCFrame:Lerp(targetCFrame, 1 / Config.Aimbot.Smoothness)
        end

        -- Triggerbot
        if Config.Aimbot.TriggerBot and hasMouseClick then
            local now = tick()
            if (now - LastTriggerTick) >= Config.Aimbot.TriggerDelay then
                LastTriggerTick = now
                pcall(function()
                    mouse1click()
                end)
            end
        end
    else
        TargetHudFrame.Visible = false
    end
end))

