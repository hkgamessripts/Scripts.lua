        fovCircle.Size = UDim2.new(0, Settings.FOVRadius * 2, 0, Settings.FOVRadius * 2)
    end
end)

-- Wall Check
local function IsVisible(targetPart)
    if not Settings.WallCheck then return true end
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {LocalPlayer.Character}
    
    local result = workspace:Raycast(Camera.CFrame.Position, (targetPart.Position - Camera.CFrame.Position), rayParams)
    if result then
        return result.Instance:IsDescendantOf(targetPart.Parent)
    end
    return true
end

-- ==========================================
-- 4. RENDERING ESQUELETO 2D
-- ==========================================
local linePool = {}
local lineIndex = 0

local function ClearLines()
    lineIndex = 0
    for _, line in ipairs(linePool) do line.Visible = false end
end

local function DrawLine(p1, p2, color)
    lineIndex = lineIndex + 1
    local line = linePool[lineIndex]
    if not line then
        line = Instance.new("Frame")
        line.AnchorPoint = Vector2.new(0.5, 0.5)
        line.BorderSizePixel = 0
        line.Parent = skeletonHolder
        table.insert(linePool, line)
    end
    
    local dist = (p2 - p1).Magnitude
    local center = (p1 + p2) / 2
    local angle = math.deg(math.atan2(p2.Y - p1.Y, p2.X - p1.X))
    
    line.Size = UDim2.new(0, dist, 0, 2)
    line.Position = UDim2.new(0, center.X, 0, center.Y)
    line.Rotation = angle
    line.BackgroundColor3 = color
    line.Visible = true
end

local bonePairs = {
    {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
    {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
    {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
    {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
    {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"},
    {"Head", "Torso"}, {"Torso", "Left Arm"}, {"Torso", "Right Arm"},
    {"Torso", "Left Leg"}, {"Torso", "Right Leg"}
}

-- ==========================================
-- 5. BUCLE PRINCIPAL (RENDERSTEPPED)
-- ==========================================
local frameCount, step = 0, 0

RunService.RenderStepped:Connect(function(dt)
    -- 1. Efecto Rainbow
    if Settings.Rainbow then
        currentColor = Color3.fromHSV(tick() % 3 / 3, 0.8, 1)
    else
        currentColor = ThemeColor
    end
    topStroke.Color = currentColor
    menuStroke.Color = currentColor
    targetCardStroke.Color = currentColor
    sliderFill.BackgroundColor3 = currentColor

    -- 2. FPS y Ping
    step = step + dt
    frameCount = frameCount + 1
    if step >= 1 then
        local ping = 0
        pcall(function() ping = math.floor(LocalPlayer:GetNetworkPing() * 1000) end)
        topText.Text = string.format("HkStudio [Elite] | FPS: %d | Ping: %dms", frameCount, ping)
        step, frameCount = 0, 0
    end

    -- 3. Círculo FOV al Mouse
    local mouseLoc = UserInputService:GetMouseLocation()
    fovCircle.Position = UDim2.new(0, mouseLoc.X, 0, mouseLoc.Y)

    -- 4. Limpieza de Líneas
    ClearLines()

    -- 5. Bucle de Jugadores
    local bestTarget = nil
    local shortestDistance = Settings.FOVRadius

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local head = char:FindFirstChild("Head")
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            local highlight = char:FindFirstChild("HkChams")
            
            -- Evaluación con Smart Team Check
            local isTeam = IsTeammate(player)
            
            if isTeam then
                -- Si es considerado aliado/intocable, quitamos Chams
                if highlight then highlight:Destroy() end
            elseif head and humanoid and humanoid.Health > 0 then
                
                -- Color según estado: Rojo Neón si es enemigo válido
                local visualColor = (Settings.SmartTeamCheck and EnemyColor) or currentColor
                
                -- CHAMS
                if Settings.Chams then
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "HkChams"
                        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        highlight.FillTransparency = 0.5
                        highlight.OutlineTransparency = 0
                        highlight.Parent = char
                    end
                    highlight.FillColor = visualColor
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                elseif highlight then
                    highlight:Destroy()
                end

                -- ESQUELETO 2D
                if Settings.Skeleton then
                    for _, pair in ipairs(bonePairs) do
                        local partA = char:FindFirstChild(pair[1])
                        local partB = char:FindFirstChild(pair[2])
                        if partA and partB then
                            local pA, visA = Camera:WorldToViewportPoint(partA.Position)
                            local pB, visB = Camera:WorldToViewportPoint(partB.Position)
                            if visA and visB then
                                DrawLine(Vector2.new(pA.X, pA.Y), Vector2.new(pB.X, pB.Y), visualColor)
                            end
                        end
                    end
                end

                -- AIMBOT
                local screenPoint, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local targetPos2D = Vector2.new(screenPoint.X, screenPoint.Y)
                    local distance = (mouseLoc - targetPos2D).Magnitude
                    
                    if distance <= Settings.FOVRadius and IsVisible(head) then
                        if distance < shortestDistance then
                            shortestDistance = distance
                            bestTarget = head
                        end
                    end
                end
            end
        end
    end

    -- 6. LÓGICA DE TARGET LOCK Y AIMBOT
    if Settings.Enabled and isAiming then
        if lockedTarget then
            local char = lockedTarget.Parent
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local plr = char and Players:GetPlayerFromCharacter(char)
            
            -- Liberar si murió, perdió visión o pasó a ser aliado/intocable
            if not (char and hum and hum.Health > 0 and IsVisible(lockedTarget) and not IsTeammate(plr)) then
                lockedTarget = nil
            end
        end

        if not lockedTarget then
            lockedTarget = bestTarget
        end

        if lockedTarget then
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, lockedTarget.Position)
            
            local char = lockedTarget.Parent
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                targetName.Text = "Target: " .. char.Name
                local healthPct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                healthBarFill.Size = UDim2.new(healthPct, 0, 1, 0)
                healthText.Text = string.format("%d / %d HP", math.floor(hum.Health), math.floor(hum.MaxHealth))
                
                targetCard.Position = UDim2.new(0, mouseLoc.X + Settings.FOVRadius + 15, 0, mouseLoc.Y - 25)
                targetCard.Visible = true
            end
        else
            targetCard.Visible = false
        end
    else
        lockedTarget = nil
        targetCard.Visible = false
    end
end)
