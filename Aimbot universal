-- ==========================================
local ConfigFileName = "HkStudio_Config.json"

local function SaveConfiguration()
    if not CheckCooldown("SaveConfig", 2) then return end
    if not hasFileAPI then Notify("Error", "APIs de archivos no soportadas.") return end
    
    Config.Settings.UIPosition = {
        X = mainFrame.Position.X.Scale,
        XOffset = mainFrame.Position.X.Offset,
        Y = mainFrame.Position.Y.Scale,
        YOffset = mainFrame.Position.Y.Offset
    }

    local saveData = { 
        Aimbot = Config.Aimbot, 
        Visuals = Config.Visuals, 
        Local = Config.Local, 
        Settings = { 
            Keybind = Config.Settings.Keybind.Name, 
            AntiAFK = Config.Settings.AntiAFK,
            UIPosition = Config.Settings.UIPosition
        } 
    }
    local success, encoded = pcall(function() return HttpService:JSONEncode(saveData) end)
    if success and encoded then
        writefile(ConfigFileName, encoded)
        Notify("Configuración", "Configuración guardada.")
    else
        Notify("Error", "Fallo al codificar JSON.")
    end
end

local function LoadConfiguration()
    if not CheckCooldown("LoadConfig", 2) then return end
    if not hasFileAPI then Notify("Error", "APIs de archivos no soportadas.") return end
    if isfile and isfile(ConfigFileName) then
        local rawData = readfile(ConfigFileName)
        local success, decoded = pcall(function() return HttpService:JSONDecode(rawData) end)
        if success and decoded then
            if decoded.Aimbot then for k,v in pairs(decoded.Aimbot) do Config.Aimbot[k] = v end end
            if decoded.Visuals then for k,v in pairs(decoded.Visuals) do Config.Visuals[k] = v end end
            if decoded.Local then for k,v in pairs(decoded.Local) do Config.Local[k] = v end end
            if decoded.Settings then
                if decoded.Settings.Keybind and Enum.KeyCode[decoded.Settings.Keybind] then Config.Settings.Keybind = Enum.KeyCode[decoded.Settings.Keybind] end
                if decoded.Settings.AntiAFK ~= nil then Config.Settings.AntiAFK = decoded.Settings.AntiAFK end
                if decoded.Settings.UIPosition then
                    local p = decoded.Settings.UIPosition
                    Config.Settings.UIPosition = p
                    mainFrame.Position = UDim2.new(p.X, p.XOffset, p.Y, p.YOffset)
                end
            end
            Notify("Configuración", "Configuración cargada.")
        else
            Notify("Error", "Archivo de configuración corrupto.")
        end
    else
        Notify("Configuración", "No hay configuración guardada previa.")
    end
end

