-- 4. BUCLE PRINCIPAL (DRAWING API, AIMBOT, SKELETON, TRIGGERBOT, CHAMS CACHE)
-- ==========================================
_G.HkFovCircle = Drawing.new("Circle")
_G.HkFovCircle.Thickness = 1
_G.HkFovCircle.Color = Color3.fromRGB(150, 150, 150)
_G.HkFovCircle.Filled = false

_G.HkDrawingCache = {}
local function GetESP(player)
    if not _G.HkDrawingCache[player] then
        _G.HkDrawingCache[player] = {
            Box = Drawing.new("Square"), 
            Tracer = Drawing.new("Line"),
            Name = Drawing.new("Text"), 
            Dist = Drawing.new("Text"),
            Skeleton = {
                Drawing.new("Line"), -- Head to Torso
                Drawing.new("Line"), -- Torso to Left Arm
                Drawing.new("Line"), -- Torso to Right Arm
                Drawing.new("Line"), -- Torso to Left Leg
                Drawing.new("Line")  -- Torso to Right Leg
            }
        }
        local esp = _G.HkDrawingCache[player]
        esp.Box.Thickness = 1; esp.Box.Filled = false
        esp.Tracer.Thickness = 1
        esp.Name.Size = 14; esp.Name.Center = true; esp.Name.Outline = true
        esp.Dist.Size = 12; esp.Dist.Center = true; esp.Dist.Outline = true
        for _, line in pairs(esp.Skeleton) do
            line.Thickness = 1
        end
    end
    return _G.HkDrawingCache[player]
end

local function ClearESP(esp)
    pcall(function()
        esp.Box.Visible = false
        esp.Tracer.Visible = false
        esp.Name.Visible = false
        esp.Dist.Visible = false
        for _, line in pairs(esp.Skeleton or {}) do
            line.Visible = false
        end
    end)
end

