local ActiveSlider = nil
table.insert(Connections, UserInputService.InputChanged:Connect(function(input)
    if ActiveSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
        local track = ActiveSlider.Track
        local min = ActiveSlider.Min
        local max = ActiveSlider.Max
        local fill = ActiveSlider.Fill
        local knob = ActiveSlider.Knob
        local valLbl = ActiveSlider.ValLbl
        local cat = ActiveSlider.Cat
        local key = ActiveSlider.Key

        local mx = UserInputService:GetMouseLocation().X
        local rel = math.clamp(mx - track.AbsolutePosition.X, 0, track.AbsoluteSize.X)
        local pctNum = rel / track.AbsoluteSize.X
        fill.Size = UDim2.new(pctNum, 0, 1, 0)
        knob.Position = UDim2.new(pctNum, -6, 0.5, -6)
        
        local value = math.floor(min + (pctNum * (max - min)))
        Config[cat][key] = value
        valLbl.Text = tostring(value)
    end
end))

