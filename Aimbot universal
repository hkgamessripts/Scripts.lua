task.spawn(function()
    while not Unloaded do
        task.wait(Config.Aimbot.TriggerDelay)
        
        local success, err = pcall(function()
            if Config.Aimbot.Enabled and Config.Aimbot.TriggerBot and hasMouseClick then
                local mousePos = UserInputService:GetMouseLocation()
                local unitRay = Camera:ScreenPointToRay(mousePos.X, mousePos.Y)
                
                TriggerBotRaycastParams.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
                local rayResult = workspace:Raycast(unitRay.Origin, unitRay.Direction * 1000, TriggerBotRaycastParams)
                
                if rayResult and rayResult.Instance then
                    local hitChar = rayResult.Instance.Parent
                    local hitPlayer = nil
                    
                    if hitChar then
                        hitPlayer = Players:GetPlayerFromCharacter(hitChar)
                        if not hitPlayer and hitChar.Parent then
                            hitPlayer = Players:GetPlayerFromCharacter(hitChar.Parent)
                        end
                    end
                    
                    if hitPlayer and hitPlayer ~= LocalPlayer and hitPlayer:IsA("Player") then
                        local cache = CharacterCache[hitPlayer]
                        if cache and cache.Humanoid and cache.RootPart and cache.Head and cache.Humanoid.Health > 0 and not IsTeammate(hitPlayer) then
                            mouse1click()
                        end
                    end
                end
            end
        end)
        
        if not success then
            task.wait(1)
        end
    end
end)
