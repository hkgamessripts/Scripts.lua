local LAW_KEYWORDS = {"police", "policia", "cop", "sheriff", "military", "ejercito", "army", "swat", "guard", "security", "guardia", "navy", "fbi"}
local OUTLAW_KEYWORDS = {"criminal", "crim", "prisoner", "preso", "inmate", "mafia", "gang", "terrorist", "outlaw", "robber", "ladron"}
local CIVIL_KEYWORDS = {"civil", "citizen", "ciudadano", "habitante", "civilian", "pueblo", "neutral", "desempleado", "none"}

local function GetFactionGroup(teamName)
    if not teamName then return nil end
    local lowerName = string.lower(tostring(teamName))
    for _, k in ipairs(LAW_KEYWORDS) do if lowerName:find(k) then return "law" end end
    for _, k in ipairs(OUTLAW_KEYWORDS) do if lowerName:find(k) then return "outlaw" end end
    for _, k in ipairs(CIVIL_KEYWORDS) do if lowerName:find(k) then return "civil" end end
    return nil
end

local function GetPlayerTeamName(player)
    if player.Team then return player.Team.Name end
    local attrs = {"Team", "Faction", "Role", "Job", "Trabajo", "Equipo", "Rol"}
    for _, attr in ipairs(attrs) do
        local val = player:GetAttribute(attr) or (player.Character and player.Character:GetAttribute(attr))
        if val then return tostring(val) end
    end
    local ls = player:FindFirstChild("leaderstats")
    if ls then
        for _, attr in ipairs(attrs) do
            local val = ls:FindFirstChild(attr) or player:FindFirstChild(attr)
            if val and val:IsA("ValueBase") then return tostring(val.Value) end
        end
    end
    return nil
end

local function IsTeammate(player)
    if not Config.Aimbot.TeamCheck then return false end
    if player == LocalPlayer then return true end
    local myTeam = GetPlayerTeamName(LocalPlayer)
    local tTeam = GetPlayerTeamName(player)
    if myTeam and tTeam then
        if myTeam:lower() == tTeam:lower() then return true end
        local myF, tF = GetFactionGroup(myTeam), GetFactionGroup(tTeam)
        if myF and tF then
            if myF == tF then return true end
            if (myF == "law" and tF == "civil") or (myF == "civil" and tF == "law") then return true end
        end
        return false
    end
    if LocalPlayer.Team ~= nil and player.Team ~= nil and LocalPlayer.TeamColor == player.TeamColor then return true end
    return false
end

