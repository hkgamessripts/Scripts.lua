local function IsVisible(part)
    if not Config.Aimbot.WallCheck then return true end
    local ray = RaycastParams.new()
    ray.FilterType = Enum.RaycastFilterType.Exclude
    ray.FilterDescendantsInstances = {LocalPlayer.Character}
    local res = workspace:Raycast(Camera.CFrame.Position, part.Position - Camera.CFrame.Position, ray)
    return res and res.Instance:IsDescendantOf(part.Parent) or false
end

-- Funciones Auxiliares para ESP
local drawingCache = {}
local function GetESP(player)
    if not drawingCache[player] then
        drawingCache[player] = {
            Box = Drawing.new("Square"),
            Tracer = Drawing.new("Line"),
            Name = Drawing.new("Text"),
            Dist = Drawing.new("Text")
        }
        drawingCache[player].Box.Thickness = 1
        drawingCache[player].Box.Filled = false
        drawingCache[player].Tracer.Thickness = 1
        drawingCache[player].Name.Size = 16
        drawingCache[player].Name.Center = true
        drawingCache[player].Name.Outline = true
        drawingCache[player].Dist.Size = 14
        drawingCache[player].Dist.Center = true
        drawingCache[player].Dist.Outline = true
    end
    return drawingCache[player]
end

local function ClearESP(esp)
    esp.Box.Visible = false
    esp.Tracer.Visible = false
    esp.Name.Visible = false
    esp.Dist.Visible = false
end

-- MAIN RENDER LOOP
table.insert(Connections, RunService.RenderStepped:Connect(function()
    if Unloaded then
        fovCircle.Visible = false
        for _, esp in pairs(drawingCache) do ClearESP(esp) end
        return
    end

    -- Rainbow Color Handler
    local activeColor = Config.Visuals.Rainbow and Color3.fromHSV(tick() % 3 / 3, 0.8, 1) or ThemeColor
    mainStroke.Color = activeColor

    -- Local Utilities Updates
    if Config.Local.Fullbright then
        Lighting.Ambient = Color3.new(1, 1, 1)
        Lighting.Brightness = 2
    end
    if Config.Local.Noclip and LocalPlayer.Character then
        for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end

    -- Update FOV
    local mousePos = UserInputService:GetMouseLocation()
    fovCircle.Position = mousePos
    fovCircle.Radius = Config.Aimbot.FOV
    fovCircle.Visible = Config.Aimbot.Enabled

    local shortestDist = Config.Aimbot.FOV
    local bestTarget = nil

    -- Player Loop (ESP & Aimbot Calculation)
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local esp = GetESP(player)
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local head = char and char:FindFirstChild("Head")
            local targetPart = char and char:FindFirstChild(Config.Aimbot.TargetPart)
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            
            local isTeam = IsTeammate(player)
            local alive = char and hum and hum.Health > 0
            
            if alive and not isTeam then
                local vector, onScreen = Camera:WorldToViewportPoint(root.Position)
                local distFromCenter = (Vector2.new(vector.X, vector.Y) - mousePos).Magnitude
                local physDist = math.floor((Camera.CFrame.Position - root.Position).Magnitude)

                -- Visuals
                local espColor = (Config.Aimbot.TeamCheck and EnemyColor) or activeColor

                -- CHAMS
                if Config.Visuals.Chams then
                    local hl = char:FindFirstChild("HkChams")
                    if not hl then
                        hl = Instance.new("Highlight")
                        hl.Name = "HkChams"
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.FillTransparency = 0.5
                        hl.Parent = char
                    end
                    hl.FillColor = espColor
                    hl.OutlineColor = Color3.new(1,1,1)
                else
                    if char:FindFirstChild("HkChams") then char.HkChams:Destroy() end
                end

                if onScreen then
                    -- BOX ESP
                    if Config.Visuals.Box then
                        local headV, _ = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                        local legV, _ = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
                        local boxHeight = math.abs(headV.Y - legV.Y)
                        esp.Box.Size = Vector2.new(boxHeight * 0.6, boxHeight)
                        esp.Box.Position = Vector2.new(headV.X - (esp.Box.Size.X / 2), headV.Y)
                        esp.Box.Color = espColor
                        esp.Box.Visible = true
                    else
                        esp.Box.Visible = false
                    end

                    -- TRACERS
                    if Config.Visuals.Tracers then
                        esp.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        esp.Tracer.To = Vector2.new(vector.X, vector.Y)
                        esp.Tracer.Color = espColor
                        esp.Tracer.Visible = true
                    else
                        esp.Tracer.Visible = false
                    end

                    -- INFO (Name & Distance & Weapon)
                    if Config.Visuals.Info then
                        esp.Name.Text = player.Name .. " [" .. physDist .. "m]"
                        esp.Name.Position = Vector2.new(vector.X, vector.Y - (esp.Box.Visible and (esp.Box.Size.Y / 2 + 20) or 20))
                        esp.Name.Color = TextWhite
                        esp.Name.Visible = true
                        
                        -- Extraer arma si la tiene en mano
                        local tool = char:FindFirstChildOfClass("Tool")
                        if tool then
                            esp.Dist.Text = tool.Name
                            esp.Dist.Position = Vector2.new(vector.X, vector.Y + (esp.Box.Visible and (esp.Box.Size.Y / 2 + 5) or 20))
                            esp.Dist.Color = Color3.fromRGB(200, 200, 200)
                            esp.Dist.Visible = true
                        else
                            esp.Dist.Visible = false
                        end
                    else
                        esp.Name.Visible = false
                        esp.Dist.Visible = false
                    end

                    -- AIMBOT CALC
                    if distFromCenter < shortestDist and targetPart and IsVisible(targetPart) then
                        shortestDist = distFromCenter
                        bestTarget = targetPart
                    end
                else
                    ClearESP(esp)
                end
            else
                ClearESP(esp)
                if char and char:FindFirstChild("HkChams") then char.HkChams:Destroy() end
            end
        end
    end

    -- Ejecución de Aimbot
    if Config.Aimbot.Enabled and isAiming then
        -- Mantener fijación si ya tenemos objetivo
        if lockedTarget and lockedTarget.Parent then
            local p = Players:GetPlayerFromCharacter(lockedTarget.Parent)
            local hum = lockedTarget.Parent:FindFirstChildOfClass("Humanoid")
            if not (hum and hum.Health > 0 and IsVisible(lockedTarget) and not IsTeammate(p)) then
                lockedTarget = nil
            end
        end

        if not lockedTarget then lockedTarget = bestTarget end

        if lockedTarget then
            local targetPos = lockedTarget.Position
            -- Predicción (Lead Target)
            if Config.Aimbot.Predict and lockedTarget.Parent:FindFirstChild("HumanoidRootPart") then
                local vel = lockedTarget.Parent.HumanoidRootPart.AssemblyLinearVelocity
                local dist = (lockedTarget.Position - Camera.CFrame.Position).Magnitude
                -- Cálculo simplificado: Asume velocidad del proyectil = 1000 studs/s
                targetPos = targetPos + (vel * (dist / 1000))
            end

            -- Smoothness (Lerp de cámara)
            local targetCFrame = CFrame.lookAt(Camera.CFrame.Position, targetPos)
            if Config.Aimbot.Smoothness > 1 then
                local factor = 1 / Config.Aimbot.Smoothness
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, factor)
            else
                Camera.CFrame = targetCFrame
            end
        end
    else
        lockedTarget = nil
    end

    -- Trigger Bot
    if Config.Aimbot.TriggerBot and Config.Aimbot.Enabled then
        local target = Mouse.Target
        if target and target.Parent and target.Parent:FindFirstChildOfClass("Humanoid") then
            local plr = Players:GetPlayerFromCharacter(target.Parent)
            if plr and not IsTeammate(plr) then
                mouse1click() -- Requiere executor nivel 8
            end
        end
    end
end))

