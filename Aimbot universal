local ActiveNotifications = {}
local MAX_NOTIFICATIONS = 3

local function Notify(title, text)
    if #ActiveNotifications >= MAX_NOTIFICATIONS then
        local oldest = table.remove(ActiveNotifications, 1)
        if oldest and oldest.Parent then oldest:Destroy() end
    end

    local notif = Instance.new("Frame", NotifyContainer)
    notif.Size = UDim2.new(1, 0, 0, 60)
    notif.BackgroundColor3 = BgDark
    notif.Position = UDim2.new(1, 300, 0, 0)
    Instance.new("UICorner", notif).CornerRadius = UDim.new(0, 6)
    local stroke = Instance.new("UIStroke", notif)
    stroke.Color = ThemeColor
    stroke.Thickness = 1
    
    local titleLbl = Instance.new("TextLabel", notif)
    titleLbl.Size = UDim2.new(1, -20, 0, 20)
    titleLbl.Position = UDim2.new(0, 10, 0, 5)
    titleLbl.BackgroundTransparency = 1
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.TextColor3 = ThemeColor
    titleLbl.Font = Enum.Font.GothamBold
    titleLbl.Text = title
    
    local textLbl = Instance.new("TextLabel", notif)
    textLbl.Size = UDim2.new(1, -20, 0, 30)
    textLbl.Position = UDim2.new(0, 10, 0, 25)
    textLbl.BackgroundTransparency = 1
    textLbl.TextXAlignment = Enum.TextXAlignment.Left
    textLbl.TextColor3 = TextWhite
    textLbl.Font = Enum.Font.Gotham
    textLbl.TextSize = 12
    textLbl.Text = text

    table.insert(ActiveNotifications, notif)
    TweenService:Create(notif, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)}):Play()
    
    task.delay(3, function()
        if notif and notif.Parent then
            local exitTween = TweenService:Create(notif, TweenInfo.new(0.3), {Position = UDim2.new(1, 300, 0, 0)})
            exitTween:Play()
            exitTween.Completed:Wait()
            for i, v in ipairs(ActiveNotifications) do
                if v == notif then table.remove(ActiveNotifications, i) break end
            end
            notif:Destroy()
        end
    end)
end

