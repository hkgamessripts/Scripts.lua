        _G.HkFovCircle.Position = mousePos
        _G.HkFovCircle.Radius = Config.Aimbot.FOV
        _G.HkFovCircle.Visible = Config.Aimbot.Enabled
    end

    local shortestDist = Config.Aimbot.FOV
    local bestTarget = nil
    local currentTargetPlayer = nil

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local esp = GetESP(player)
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local head = char and char:FindFirstChild("Head")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local aimPart = char and char:FindFirstChild(Config.Aimbot.TargetPart)
            
            local chamsObj = char and char:FindFirstChild("HkChams")
            if chamsObj then chamsObj.Enabled = Config.Visuals.Chams end

            if char and root and head and aimPart and hum and hum.Health > 0 and not IsTeammate(player) then
                local vector, onScreen = Camera:WorldToViewportPoint(root.Position)
                local distFromCenter = (Vector2.new(vector.X, vector.Y) - mousePos).Magnitude
                local physDist = math.floor((Camera.CFrame.Position - root.Position).Magnitude)

                if onScreen and hasDrawing then
                    if Config.Visuals.Box and esp and esp.Box then
                        local headV = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                        local legV = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
                        local boxH = math.abs(headV.Y - legV.Y)
                        esp.Box.Size = Vector2.new(boxH * 0.6, boxH)
                        esp.Box.Position = Vector2.new(headV.X - (esp.Box.Size.X / 2), headV.Y)
                        esp.Box.Color = activeColor
                        esp.Box.Visible = true
                    elseif esp and esp.Box then esp.Box.Visible = false end

                    if Config.Visuals.Tracers and esp and esp.Tracer then
                        esp.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        esp.Tracer.To = Vector2.new(vector.X, vector.Y)
                        esp.Tracer.Color = activeColor
                        esp.Tracer.Visible = true
                    elseif esp and esp.Tracer then esp.Tracer.Visible = false end

                    if Config.Visuals.Info and esp and esp.Name and esp.Dist then
                        esp.Name.Text = player.Name
                        esp.Name.Position = Vector2.new(vector.X, vector.Y - 20)
                        esp.Name.Color = TextWhite
                        esp.Name.Visible = true
                        
                        local tool = char:FindFirstChildOfClass("Tool")
                        esp.Dist.Text = tool and (tool.Name .. " ["..physDist.."m]") or "["..physDist.."m]"
                        esp.Dist.Position = Vector2.new(vector.X, vector.Y + 20)
                        esp.Dist.Color = tool and EnemyColor or Color3.fromRGB(150,150,150)
                        esp.Dist.Visible = true
                    elseif esp and esp.Name and esp.Dist then
                        esp.Name.Visible = false
                        esp.Dist.Visible = false
                    end

                    if Config.Visuals.Skeleton and esp and esp.Skeleton then
                        local upperTorso = char:FindFirstChild("UpperTorso")
                        local lowerTorso = char:FindFirstChild("LowerTorso")
                        local leftUpperArm = char:FindFirstChild("LeftUpperArm")
                        local rightUpperArm = char:FindFirstChild("RightUpperArm")
                        local leftUpperLeg = char:FindFirstChild("LeftUpperLeg")
                        local rightUpperLeg = char:FindFirstChild("RightUpperLeg")

                        if upperTorso and head and lowerTorso then
                            local hPos = Camera:WorldToViewportPoint(head.Position)
                            local uPos = Camera:WorldToViewportPoint(upperTorso.Position)
                            local lPos = Camera:WorldToViewportPoint(lowerTorso.Position)
                            
                            esp.Skeleton[1].From = Vector2.new(hPos.X, hPos.Y)
                            esp.Skeleton[1].To = Vector2.new(uPos.X, uPos.Y)
                            esp.Skeleton[1].Color = activeColor
                            esp.Skeleton[1].Visible = true

                            esp.Skeleton[2].From = Vector2.new(uPos.X, uPos.Y)
                            esp.Skeleton[2].To = Vector2.new(lPos.X, lPos.Y)
                            esp.Skeleton[2].Color = activeColor
                            esp.Skeleton[2].Visible = true

                            if leftUpperArm then
                                local laPos = Camera:WorldToViewportPoint(leftUpperArm.Position)
                                esp.Skeleton[3].From = Vector2.new(uPos.X, uPos.Y)
                                esp.Skeleton[3].To = Vector2.new(laPos.X, laPos.Y)
                                esp.Skeleton[3].Color = activeColor
                                esp.Skeleton[3].Visible = true
                            else
                                esp.Skeleton[3].Visible = false
                            end

                            if rightUpperArm then
                                local raPos = Camera:WorldToViewportPoint(rightUpperArm.Position)
                                esp.Skeleton[4].From = Vector2.new(uPos.X, uPos.Y)
                                esp.Skeleton[4].To = Vector2.new(raPos.X, raPos.Y)
                                esp.Skeleton[4].Color = activeColor
                                esp.Skeleton[4].Visible = true
                            else
                                esp.Skeleton[4].Visible = false
                            end

                            if leftUpperLeg then
                                local llPos = Camera:WorldToViewportPoint(leftUpperLeg.Position)
                                esp.Skeleton[5].From = Vector2.new(lPos.X, lPos.Y)
                                esp.Skeleton[5].To = Vector2.new(llPos.X, llPos.Y)
                                esp.Skeleton[5].Color = activeColor
                                esp.Skeleton[5].Visible = true
                            else
                                esp.Skeleton[5].Visible = false
                            end

                            if rightUpperLeg then
                                local rlPos = Camera:WorldToViewportPoint(rightUpperLeg.Position)
                                esp.Skeleton[6].From = Vector2.new(lPos.X, lPos.Y)
                                esp.Skeleton[6].To = Vector2.new(rlPos.X, rlPos.Y)
                                esp.Skeleton[6].Color = activeColor
                                esp.Skeleton[6].Visible = true
                            else
                                esp.Skeleton[6].Visible = false
                            end
                        else
                            for _, line in pairs(esp.Skeleton) do line.Visible = false end
                        end
                    elseif esp and esp.Skeleton then
                        for _, line in pairs(esp.Skeleton) do line.Visible = false end
                    end

                    if distFromCenter < shortestDist and aimPart then
                        if IsVisible(aimPart) then
                            shortestDist = distFromCenter
                            bestTarget = aimPart
                            currentTargetPlayer = player
                        end
                    end
                else
                    ClearESP(esp)
                end
            else
                ClearESP(esp)
            end
        end
    end

    -- Aimbot con Smoothness, Predicción y Target HUD
    if Config.Aimbot.Enabled and isAiming then
        if lockedTarget then
            local targetChar = lockedTarget.Parent
            local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
            if not (targetHum and targetHum.Health > 0 and IsVisible(lockedTarget)) then
                lockedTarget = nil
            end
        end
        if not lockedTarget then lockedTarget = bestTarget end

        if lockedTarget and lockedTarget.Parent then
            local targetChar = lockedTarget.Parent
            local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
            local targetPlayer = Players:GetPlayerFromCharacter(targetChar)

            -- Actualizar y mostrar Target HUD
            if targetPlayer and targetHum then
                targetNameLbl.Text = targetPlayer.Name
                local healthPct = math.clamp(targetHum.Health / targetHum.MaxHealth, 0, 1)
                targetHealthFill.Size = UDim2.new(healthPct, 0, 1, 0)
                targetHealthText.Text = math.floor(targetHum.Health) .. " / " .. math.floor(targetHum.MaxHealth) .. " (" .. math.floor(healthPct * 100) .. "%)"
                
                -- Posicionar al lado del cursor / FOV
                TargetHudFrame.Position = UDim2.new(0, mousePos.X + Config.Aimbot.FOV + 15, 0, mousePos.Y - 24)
                TargetHudFrame.Visible = true
            else
                TargetHudFrame.Visible = false
            end

            local targetPos = lockedTarget.Position
            if Config.Aimbot.Predict and targetChar:FindFirstChild("HumanoidRootPart") then
                local rootPart = targetChar.HumanoidRootPart
                local dist = (lockedTarget.Position - Camera.CFrame.Position).Magnitude
                local ping = 0
                pcall(function() ping = LocalPlayer:GetNetworkPing() end)
                local predMult = math.max(1, Config.Aimbot.PredictionMultiplier)
                targetPos = targetPos + (rootPart.AssemblyLinearVelocity * ((dist / predMult) + ping))
            end
            
            local targetCFrame = CFrame.lookAt(Camera.CFrame.Position, targetPos)
            local smoothness = math.max(1, Config.Aimbot.Smoothness)
            Camera.CFrame = (smoothness > 1) and Camera.CFrame:Lerp(targetCFrame, 1 / smoothness) or targetCFrame
        else
            TargetHudFrame.Visible = false
        end
    else
        TargetHudFrame.Visible = false
        lockedTarget = nil
    end

    -- TriggerBot Eficiente
    if Config.Aimbot.Enabled and Config.Aimbot.TriggerBot and hasMouseClick then
        if tick() - LastTriggerTick >= Config.Aimbot.TriggerDelay then
            local unitRay = Camera:ScreenPointToRay(mousePos.X, mousePos.Y)
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.IgnoreWater = true
            if LocalPlayer.Character then params.FilterDescendantsInstances = {LocalPlayer.Character, Camera} end
            
            local rayResult = workspace:Raycast(unitRay.Origin, unitRay.Direction * 1000, params)
            if rayResult and rayResult.Instance then
                local hitChar = rayResult.Instance.Parent
                local hitHum = hitChar:FindFirstChildOfClass("Humanoid")
                if not hitHum and hitChar.Parent then
                    hitChar = hitChar.Parent
                    hitHum = hitChar:FindFirstChildOfClass("Humanoid")
                end
                local hitPlayer = Players:GetPlayerFromCharacter(hitChar)
                if hitHum and hitHum.Health > 0 and hitPlayer and hitPlayer ~= LocalPlayer then
                    if not IsTeammate(hitPlayer) then
                        mouse1click()
                        LastTriggerTick = tick()
                    end
                end
            end
        end
    end
end))
