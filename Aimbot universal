-- 4. RENDERING ESQUELETO 2D
-- ==========================================
local linePool = {}
local lineIndex = 0

local function ClearLines()
    lineIndex = 0
    for i = 1, #linePool do linePool[i].Visible = false end
end

local function DrawLine(p1, p2, color)
    lineIndex = lineIndex + 1
    local line = linePool[lineIndex]
    if not line then
        line = Instance.new("Frame")
        line.AnchorPoint = Vector2New(0.5, 0.5)
        line.BorderSizePixel = 0
        line.Parent = skeletonHolder
        table.insert(linePool, line)
    end
    
    local dist = (p2 - p1).Magnitude
    local center = (p1 + p2) / 2
    local angle = MathDeg(MathAtan2(p2.Y - p1.Y, p2.X - p1.X))
    
    line.Size = UDim2New(0, dist, 0, 2)
    line.Position = UDim2New(0, center.X, 0, center.Y)
    line.Rotation = angle
    line.BackgroundColor3 = color
    line.Visible = true
end

local bonePairs = {
    {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
    {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
    {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
    {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
    {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"},
    {"Head", "Torso"}, {"Torso", "Left Arm"}, {"Torso", "Right Arm"},
    {"Torso", "Left Leg"}, {"Torso", "Right Leg"}
}

-- ==========================================
-- 5. BUCLE PRINCIPAL (RENDERSTEPPED)
-- ==========================================
local frameCount, step = 0, 0

RunService.RenderStepped:Connect(function(dt)
    if Settings.Rainbow then
        currentColor = Color3.fromHSV(tick() % 3 / 3, 0.8, 1)
    else
        currentColor = ThemeColor
    end
    topStroke.Color = currentColor
    menuStroke.Color = currentColor
    targetCardStroke.Color = currentColor
    sliderFill.BackgroundColor3 = currentColor

    step = step + dt
    frameCount = frameCount + 1
    if step >= 1 then
        local ping = 0
        pcall(function() ping = MathFloor(LocalPlayer:GetNetworkPing() * 1000) end)
        topText.Text = string.format("HkStudio [Elite] | FPS: %d | Ping: %dms", frameCount, ping)
        step, frameCount = 0, 0
    end

    local mouseLoc = UserInputService:GetMouseLocation()
    fovCircle.Position = UDim2New(0, mouseLoc.X, 0, mouseLoc.Y)

    ClearLines()

    local bestTarget = nil
    local shortestDistance = Settings.FOVRadius

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local head = char:FindFirstChild("Head")
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            local highlight = char:FindFirstChild("HkChams")
            
            local isTeam = IsTeammate(player)
            local isInvulnerable = IsInvulnerable(player)
            
            if isTeam then
                -- Si es aliado, removemos Chams
                if highlight then highlight:Destroy() end
            elseif head and humanoid and humanoid.Health > 0 then
                
                local visualColor = (Settings.TeamCheck and EnemyColor) or currentColor
                
                -- CHAMS (Incluso si tiene escudo, se dibuja en el ESP)
                if Settings.Chams then
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "HkChams"
                        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        highlight.FillTransparency = 0.5
                        highlight.OutlineTransparency = 0
                        highlight.Parent = char
                    end
                    highlight.FillColor = visualColor
                    highlight.OutlineColor = Color3FromRGB(255, 255, 255)
                elseif highlight then
                    highlight:Destroy()
                end

                -- ESQUELETO 2D
                if Settings.Skeleton then
                    for i = 1, #bonePairs do
                        local pair = bonePairs[i]
                        local partA = char:FindFirstChild(pair[1])
                        local partB = char:FindFirstChild(pair[2])
                        if partA and partB then
                            local pA, visA = Camera:WorldToViewportPoint(partA.Position)
                            local pB, visB = Camera:WorldToViewportPoint(partB.Position)
                            if visA and visB then
                                DrawLine(Vector2New(pA.X, pA.Y), Vector2New(pB.X, pB.Y), visualColor)
                            end
                        end
                    end
                end

                -- AIMBOT (Solo selecciona como objetivo si NO es invulnerable)
                if not isInvulnerable then
                    local screenPoint, onScreen = Camera:WorldToViewportPoint(head.Position)
                    if onScreen then
                        local targetPos2D = Vector2New(screenPoint.X, screenPoint.Y)
                        local distance = (mouseLoc - targetPos2D).Magnitude
                        
                        if distance < shortestDistance then
                            if IsVisible(head) then
                                shortestDistance = distance
                                bestTarget = head
                            end
                        end
                    end
                end
            end
        end
    end

    -- TARGET LOCK
    if Settings.Enabled and isAiming then
        if lockedTarget then
            local char = lockedTarget.Parent
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local plr = char and Players:GetPlayerFromCharacter(char)
            
            if not (char and hum and hum.Health > 0 and IsVisible(lockedTarget) and not IsTeammate(plr) and not IsInvulnerable(plr)) then
                lockedTarget = nil
            end
        end

        if not lockedTarget then
            lockedTarget = bestTarget
        end

        if lockedTarget then
            Camera.CFrame = CFrameLookAt(Camera.CFrame.Position, lockedTarget.Position)
            
            local char = lockedTarget.Parent
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                targetName.Text = "Target: " .. char.Name
                local healthPct = MathClamp(hum.Health / hum.MaxHealth, 0, 1)
                healthBarFill.Size = UDim2New(healthPct, 0, 1, 0)
                healthText.Text = string.format("%d / %d HP", MathFloor(hum.Health), MathFloor(hum.MaxHealth))
                
                targetCard.Position = UDim2New(0, mouseLoc.X + Settings.FOVRadius + 15, 0, mouseLoc.Y - 25)
                targetCard.Visible = true
            end
        else
            targetCard.Visible = false
        end
    else
        lockedTarget = nil
        targetCard.Visible = false
    end
end)
