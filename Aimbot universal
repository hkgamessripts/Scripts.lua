    if _G.HkDrawingCache[player] then
        pcall(function()
            local esp = _G.HkDrawingCache[player]
            esp.Box:Remove()
            esp.Tracer:Remove()
            esp.Name:Remove()
            esp.Dist:Remove()
            for _, line in pairs(esp.Skeleton) do line:Remove() end
        end)
        _G.HkDrawingCache[player] = nil
    end
end))

-- Gestión de Chams mediante CharacterAdded / DescendantAdded para evitar sobrecarga en RenderStepped
local function SetupChams(player)
    if player == LocalPlayer then return end
    local function applyHighlight(char)
        if not char then return end
        local hl = char:FindFirstChild("HkChams")
        if not hl then
            hl = Instance.new("Highlight")
            hl.Name = "HkChams"
            hl.Parent = char
        end
        hl.FillColor = EnemyColor
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Enabled = Config.Visuals.Chams
    end

    table.insert(Connections, player.CharacterAdded:Connect(function(char)
        applyHighlight(char)
    end))
    if player.Character then
        applyHighlight(player.Character)
    end
end

for _, p in ipairs(Players:GetPlayers()) do
    SetupChams(p)
end
table.insert(Connections, Players.PlayerAdded:Connect(function(p)
    SetupChams(p)
end))

local isAiming = false
local lockedTarget = nil
table.insert(Connections, UserInputService.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton2 then isAiming = true end end))
table.insert(Connections, UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton2 then isAiming = false; lockedTarget = nil end end))

table.insert(Connections, RunService.RenderStepped:Connect(function()
    if Unloaded then return end

    local activeColor = Config.Visuals.Rainbow and Color3.fromHSV(time() % 3 / 3, 0.8, 1) or ThemeColor
    mainStroke.Color = activeColor
    
    local mousePos = UserInputService:GetMouseLocation()
    _G.HkFovCircle.Position = mousePos
    _G.HkFovCircle.Radius = Config.Aimbot.FOV
    _G.HkFovCircle.Visible = Config.Aimbot.Enabled

    local shortestDist = Config.Aimbot.FOV
    local bestTarget = nil

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local esp = GetESP(player)
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local head = char and char:FindFirstChild("Head")
            local aimPart = char and char:FindFirstChild(Config.Aimbot.TargetPart)
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            
            -- Sincronizar Chams en tiempo real según configuración
            local chamsObj = char and char:FindFirstChild("HkChams")
            if chamsObj then
                chamsObj.Enabled = Config.Visuals.Chams
            end

            if char and root and head and aimPart and hum and hum.Health > 0 and not IsTeammate(player) then
                local vector, onScreen = Camera:WorldToViewportPoint(root.Position)
                local distFromCenter = (Vector2.new(vector.X, vector.Y) - mousePos).Magnitude
                local physDist = math.floor((Camera.CFrame.Position - root.Position).Magnitude)

                if onScreen then
                    -- Box ESP
                    if Config.Visuals.Box then
                        local headV = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                        local legV = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
                        local boxH = math.abs(headV.Y - legV.Y)
                        esp.Box.Size = Vector2.new(boxH * 0.6, boxH)
                        esp.Box.Position = Vector2.new(headV.X - (esp.Box.Size.X / 2), headV.Y)
                        esp.Box.Color = activeColor
                        esp.Box.Visible = true
                    else esp.Box.Visible = false end

                    -- Tracers
                    if Config.Visuals.Tracers then
                        esp.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        esp.Tracer.To = Vector2.new(vector.X, vector.Y)
                        esp.Tracer.Color = activeColor
                        esp.Tracer.Visible = true
                    else esp.Tracer.Visible = false end

                    -- Skeleton ESP
                    if Config.Visuals.Skeleton then
                        pcall(function()
                            local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
                            local leftArm = char:FindFirstChild("LeftUpperArm") or char:FindFirstChild("Left Arm")
                            local rightArm = char:FindFirstChild("RightUpperArm") or char:FindFirstChild("Right Arm")
                            local leftLeg = char:FindFirstChild("LeftUpperLeg") or char:FindFirstChild("Left Leg")
                            local rightLeg = char:FindFirstChild("RightUpperLeg") or char:FindFirstChild("Right Leg")

                            if head and torso then
                                local hPos, hVis = Camera:WorldToViewportPoint(head.Position)
                                local tPos, tVis = Camera:WorldToViewportPoint(torso.Position)
                                if hVis and tVis then
                                    esp.Skeleton[1].From = Vector2.new(hPos.X, hPos.Y)
                                    esp.Skeleton[1].To = Vector2.new(tPos.X, tPos.Y)
                                    esp.Skeleton[1].Color = activeColor
                                    esp.Skeleton[1].Visible = true
                                else esp.Skeleton[1].Visible = false end

                                if leftArm then
                                    local laPos, laVis = Camera:WorldToViewportPoint(leftArm.Position)
                                    if tVis and laVis then
                                        esp.Skeleton[2].From = Vector2.new(tPos.X, tPos.Y)
                                        esp.Skeleton[2].To = Vector2.new(laPos.X, laPos.Y)
                                        esp.Skeleton[2].Color = activeColor
                                        esp.Skeleton[2].Visible = true
                                    else esp.Skeleton[2].Visible = false end
                                else esp.Skeleton[2].Visible = false end

                                if rightArm then
                                    local raPos, raVis = Camera:WorldToViewportPoint(rightArm.Position)
                                    if tVis and raVis then
                                        esp.Skeleton[3].From = Vector2.new(tPos.X, tPos.Y)
                                        esp.Skeleton[3].To = Vector2.new(raPos.X, raPos.Y)
                                        esp.Skeleton[3].Color = activeColor
                                        esp.Skeleton[3].Visible = true
                                    else esp.Skeleton[3].Visible = false end
                                else esp.Skeleton[3].Visible = false end

                                if leftLeg then
                                    local llPos, llVis = Camera:WorldToViewportPoint(leftLeg.Position)
                                    if tVis and llVis then
                                        esp.Skeleton[4].From = Vector2.new(tPos.X, tPos.Y)
                                        esp.Skeleton[4].To = Vector2.new(llPos.X, llPos.Y)
                                        esp.Skeleton[4].Color = activeColor
                                        esp.Skeleton[4].Visible = true
                                    else esp.Skeleton[4].Visible = false end
                                else esp.Skeleton[4].Visible = false end

                                if rightLeg then
                                    local rlPos, rlVis = Camera:WorldToViewportPoint(rightLeg.Position)
                                    if tVis and rlVis then
                                        esp.Skeleton[5].From = Vector2.new(tPos.X, tPos.Y)
                                        esp.Skeleton[5].To = Vector2.new(rlPos.X, rlPos.Y)
                                        esp.Skeleton[5].Color = activeColor
                                        esp.Skeleton[5].Visible = true
                                    else esp.Skeleton[5].Visible = false end
                                else esp.Skeleton[5].Visible = false end
                            else
                                for _, line in pairs(esp.Skeleton) do line.Visible = false end
                            end
                        end)
                    else
                        for _, line in pairs(esp.Skeleton) do line.Visible = false end
                    end

                    -- Info
                    if Config.Visuals.Info then
                        esp.Name.Text = player.Name
                        esp.Name.Position = Vector2.new(vector.X, vector.Y - (esp.Box.Visible and (esp.Box.Size.Y / 2 + 20) or 20))
                        esp.Name.Color = TextWhite
                        esp.Name.Visible = true
                        
                        local tool = char:FindFirstChildOfClass("Tool")
                        esp.Dist.Text = tool and (tool.Name .. " ["..physDist.."m]") or "["..physDist.."m]"
                        esp.Dist.Position = Vector2.new(vector.X, vector.Y + (esp.Box.Visible and (esp.Box.Size.Y / 2 + 5) or 20))
                        esp.Dist.Color = tool and EnemyColor or Color3.fromRGB(150,150,150)
                        esp.Dist.Visible = true
                    else
                        esp.Name.Visible = false; esp.Dist.Visible = false
                    end

                    -- Aimbot Search (Validando Wall Check solo para candidatos viables dentro del FOV)
                    if distFromCenter < shortestDist and aimPart then
                        if IsVisible(aimPart) then
                            shortestDist = distFromCenter
                            bestTarget = aimPart
                        end
                    end
                else
                    ClearESP(esp)
                end
            else
                ClearESP(esp)
            end
        end
    end

    -- AIMBOT Y TARGET LOCK LOGIC
    if Config.Aimbot.Enabled and isAiming then
        -- Validar si el objetivo actual sigue siendo válido, visible y dentro del FOV
        if lockedTarget then
            local isValid = false
            pcall(function()
                local targetChar = lockedTarget.Parent
                local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
                local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
                if targetChar and targetHum and targetHum.Health > 0 and targetRoot then
                    local vec, onScreen = Camera:WorldToViewportPoint(targetRoot.Position)
                    local dist = (Vector2.new(vec.X, vec.Y) - mousePos).Magnitude
                    if onScreen and dist <= Config.Aimbot.FOV and IsVisible(lockedTarget) then
                        isValid = true
                    end
                end
            end)
            if not isValid then
                lockedTarget = nil
            end
        end

        if not lockedTarget then
            lockedTarget = bestTarget
        end

        if lockedTarget and lockedTarget.Parent then
            pcall(function()
                local targetPos = lockedTarget.Position
                if Config.Aimbot.Predict and lockedTarget.Parent:FindFirstChild("HumanoidRootPart") then
                    local rootPart = lockedTarget.Parent.HumanoidRootPart
                    local vel = rootPart.AssemblyLinearVelocity
                    local dist = (lockedTarget.Position - Camera.CFrame.Position).Magnitude
                    local ping = 0
                    pcall(function() ping = LocalPlayer:GetNetworkPing() end)
                    -- Predicción avanzada considerando velocidad, distancia y ping
                    local leadTime = (dist / Config.Aimbot.PredictionMultiplier) + ping
                    targetPos = targetPos + (vel * leadTime)
                end
                
                local targetCFrame = CFrame.lookAt(Camera.CFrame.Position, targetPos)
                if Config.Aimbot.Smoothness > 1 then
                    Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, 1 / Config.Aimbot.Smoothness)
                else
                    Camera.CFrame = targetCFrame
                end
            end)
        end
    end

    -- TRIGGERBOT LOGIC
    if Config.Aimbot.Enabled and Config.Aimbot.TriggerBot then
        pcall(function()
            local mouseTarget = LocalPlayer:GetMouse().Target
            if mouseTarget and mouseTarget.Parent then
                local enemyChar = mouseTarget.Parent
                local enemyHum = enemyChar:FindFirstChildOfClass("Humanoid")
                local enemyPlayer = Players:GetPlayerFromCharacter(enemyChar)
                if enemyHum and enemyHum.Health > 0 and enemyPlayer and enemyPlayer ~= LocalPlayer then
                    if not IsTeammate(enemyPlayer) then
                        mouse1click()
                    end
                end
            end
        end)
    end
end))
