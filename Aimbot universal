CreateButton(tabSettings, "Unlink", function()
    Unloaded = true
    
    -- Destruir FOV circle
    if fovCircle then pcall(function() fovCircle:Remove() end) end

    -- Desconectar conexiones
    for _, conn in ipairs(Connections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(Connections)
    
    -- Limpiar ESP y Chams en todos los jugadores
    for player, esp in pairs(EspCache) do
        pcall(function()
            if esp.Box then esp.Box:Remove() end
            if esp.Tracer then esp.Tracer:Remove() end
            if esp.Info then esp.Info:Remove() end
            if esp.Bones then
                for _, bone in ipairs(esp.Bones) do bone:Remove() end
            end
        end)
        if player.Character then
            local hl = player.Character:FindFirstChild("HkChamsHighlight")
            if hl then hl:Destroy() end
        end
    end
    table.clear(EspCache)

    -- Restaurar iluminación y mapa
    pcall(function()
        Lighting.Ambient = OriginalLighting.Ambient
        Lighting.Brightness = OriginalLighting.Brightness
        Lighting.GlobalShadows = OriginalLighting.GlobalShadows
        Lighting.FogEnd = OriginalLighting.FogEnd
    end)

    for part, mat in pairs(OriginalMaterials) do
        if part and part.Parent then part.Material = mat end
    end
    table.clear(OriginalMaterials)

    for decal, trans in pairs(OriginalDecalTransparencies) do
        if decal and decal.Parent then decal.Transparency = trans end
    end
    table.clear(OriginalDecalTransparencies)

    for tex, trans in pairs(OriginalTextureTransparencies) do
        if tex and tex.Parent then tex.Transparency = trans end
    end
    table.clear(OriginalTextureTransparencies)

    -- Restaurar personaje local si tenía Korblox/Headless
    if LocalPlayer.Character then
        for pName, trans in pairs(OriginalTransparencies) do
            local p = LocalPlayer.Character:FindFirstChild(pName)
            if p then p.Transparency = trans end
        end
        local head = LocalPlayer.Character:FindFirstChild("Head")
        if head then
            local face = head:FindFirstChild("face")
            if face and OriginalTransparencies["Face"] then face.Transparency = OriginalTransparencies["Face"] end
        end
    end

    -- Destruir GUI principal
    pcall(function() hkGui:Destroy() end)
end)

