local function GetOrCreateEsp(player)
    if EspCache[player] then return EspCache[player] end
    if not hasDrawing then return nil end

    local espData = {
        Box = Drawing.new("Square"),
        Tracer = Drawing.new("Line"),
        Info = Drawing.new("Text"),
        Bones = {
            Drawing.new("Line"),
            Drawing.new("Line"),
            Drawing.new("Line"),
            Drawing.new("Line"),
            Drawing.new("Line"),
            Drawing.new("Line"),
            Drawing.new("Line"),
            Drawing.new("Line"),
            Drawing.new("Line"),
            Drawing.new("Line"),
        }
    }

    espData.Box.Visible = false
    espData.Box.Filled = false
    espData.Box.Thickness = 1.5

    espData.Tracer.Visible = false
    espData.Tracer.Thickness = 1.5

    espData.Info.Visible = false
    espData.Info.Size = 13
    espData.Info.Center = true
    espData.Info.Outline = true

    for _, bone in ipairs(espData.Bones) do
        bone.Visible = false
        bone.Thickness = 1.5
    end

    EspCache[player] = espData
    return espData
end

local function RemoveEsp(player)
    if EspCache[player] then
        pcall(function()
            EspCache[player].Box:Remove()
            EspCache[player].Tracer:Remove()
            EspCache[player].Info:Remove()
            for _, bone in ipairs(EspCache[player].Bones) do bone:Remove() end
        end)
        EspCache[player] = nil
    end
    if player.Character then
        local hl = player.Character:FindFirstChild("HkChamsHighlight")
        if hl then hl:Destroy() end
    end
end

Players.PlayerRemoving:Connect(RemoveEsp)

table.insert(Connections, RunService.RenderStepped:Connect(function()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local esp = GetOrCreateEsp(player)
            local char = player.Character
            local rootPart = char and char:FindFirstChild("HumanoidRootPart")
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")

            if char then
                local hl = char:FindFirstChild("HkChamsHighlight")
                if Config.Visuals.Chams and humanoid and humanoid.Health > 0 and not IsTeammate(player) then
                    if not hl then
                        hl = Instance.new("Highlight")
                        hl.Name = "HkChamsHighlight"
                        hl.Adornee = char
                        hl.Parent = char
                    end
                    hl.Enabled = true
                    hl.FillColor = CurrentThemeColor
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.FillTransparency = 0.5
                else
                    if hl then hl.Enabled = false end
                end
            end

            if esp and rootPart and humanoid and humanoid.Health > 0 and not IsTeammate(player) then
                local rootPos, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
                if onScreen then
                    local distance = (Camera.CFrame.Position - rootPart.Position).Magnitude
                    
                    if Config.Visuals.Box then
                        local size = char:GetExtentsSize()
                        local topPos, topOnScreen = Camera:WorldToViewportPoint(rootPart.Position + Vector3.new(0, size.Y / 2 + 0.5, 0))
                        local botPos, botOnScreen = Camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, size.Y / 2 + 0.5, 0))
                        if topOnScreen and botOnScreen then
                            local height = math.abs(topPos.Y - botPos.Y)
                            local width = height / 2
                            esp.Box.Size = Vector2.new(width, height)
                            esp.Box.Position = Vector2.new(rootPos.X - width / 2, topPos.Y)
                            esp.Box.Color = CurrentThemeColor
                            esp.Box.Visible = true
                        else
                            esp.Box.Visible = false
                        end
                    else
                        esp.Box.Visible = false
                    end

                    if Config.Visuals.Tracers then
                        esp.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        esp.Tracer.To = Vector2.new(rootPos.X, rootPos.Y)
                        esp.Tracer.Color = CurrentThemeColor
                        esp.Tracer.Visible = true
                    else
                        esp.Tracer.Visible = false
                    end

                    if Config.Visuals.Info then
                        esp.Info.Position = Vector2.new(rootPos.X, rootPos.Y - 35)
                        esp.Info.Text = string.format("%s [%dm]", player.Name, math.floor(distance))
                        esp.Info.Color = TextWhite
                        esp.Info.Visible = true
                    else
                        esp.Info.Visible = false
                    end

                    if Config.Visuals.Skeleton then
                        local head = char:FindFirstChild("Head")
                        local upperTorso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
                        local lowerTorso = char:FindFirstChild("LowerTorso") or rootPart
                        local leftUpperArm = char:FindFirstChild("LeftUpperArm") or char:FindFirstChild("Left Arm")
                        local leftLowerArm = char:FindFirstChild("LeftLowerArm")
                        local rightUpperArm = char:FindFirstChild("RightUpperArm") or char:FindFirstChild("Right Arm")
                        local rightLowerArm = char:FindFirstChild("RightLowerArm")
                        local leftUpperLeg = char:FindFirstChild("LeftUpperLeg") or char:FindFirstChild("Left Leg")
                        local leftLowerLeg = char:FindFirstChild("LeftLowerLeg")
                        local rightUpperLeg = char:FindFirstChild("RightUpperLeg") or char:FindFirstChild("Right Leg")
                        local rightLowerLeg = char:FindFirstChild("RightLowerLeg")

                        local bonePairs = {
                            {head, upperTorso},
                            {upperTorso, lowerTorso},
                            {upperTorso, leftUpperArm},
                            {leftUpperArm, leftLowerArm},
                            {upperTorso, rightUpperArm},
                            {rightUpperArm, rightLowerArm},
                            {lowerTorso, leftUpperLeg},
                            {leftUpperLeg, leftLowerLeg},
                            {lowerTorso, rightUpperLeg},
                            {rightUpperLeg, rightLowerLeg}
                        }

                        for i, pair in ipairs(bonePairs) do
                            local p1, p2 = pair[1], pair[2]
                            local boneLine = esp.Bones[i]
                            if boneLine and p1 and p2 then
                                local pos1, vis1 = Camera:WorldToViewportPoint(p1.Position)
                                local pos2, vis2 = Camera:WorldToViewportPoint(p2.Position)
                                if vis1 and vis2 then
                                    boneLine.From = Vector2.new(pos1.X, pos1.Y)
                                    boneLine.To = Vector2.new(pos2.X, pos2.Y)
                                    boneLine.Color = CurrentThemeColor
                                    boneLine.Visible = true
                                else
                                    boneLine.Visible = false
                                end
                            else
                                if boneLine then boneLine.Visible = false end
                            end
                        end
                    else
                        for _, bone in ipairs(esp.Bones) do bone.Visible = false end
                    end
                else
                    esp.Box.Visible = false
                    esp.Tracer.Visible = false
                    esp.Info.Visible = false
                    for _, bone in ipairs(esp.Bones) do bone.Visible = false end
                end
            else
                if esp then
                    esp.Box.Visible = false
                    esp.Tracer.Visible = false
                    esp.Info.Visible = false
                    for _, bone in ipairs(esp.Bones) do bone.Visible = false end
                end
            end
        end
    end
end))

-- ==========================================
-- 7. MOTOR DE AIMBOT (Suavizado Dinámico)
-- ==========================================
table.insert(Connections, RunService.RenderStepped:Connect(function(dt)
    if not Config.Aimbot.Enabled then
        TargetHudFrame.Visible = false
        return
    end

    if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        TargetHudFrame.Visible = false
        return
    end

    local closestTarget = nil
    local shortestDist = Config.Aimbot.FOV
    local mousePos = UserInputService:GetMouseLocation()

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and not IsTeammate(player) then
            local char = player.Character
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
            if char and humanoid and humanoid.Health > 0 then
                local targetPart = char:FindFirstChild(Config.Aimbot.TargetPart) or char:FindFirstChild("Head")
                if targetPart and IsVisible(targetPart) then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        if dist < shortestDist then
                            shortestDist = dist
                            closestTarget = targetPart
                        end
                    end
                end
            end
        end
    end

    if closestTarget then
        local targetChar = closestTarget.Parent
        local humanoid = targetChar:FindFirstChildOfClass("Humanoid")
        if humanoid then
            local healthPct = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
            targetHealthFill.Size = UDim2.new(healthPct, 0, 1, 0)
            targetHealthText.Text = math.floor(healthPct * 100) .. "%"
            targetNameLbl.Text = targetChar.Name
            TargetHudFrame.Visible = true
        end

        local targetPos = closestTarget.Position
        local currentCFrame = Camera.CFrame
        local targetCFrame = CFrame.new(currentCFrame.Position, targetPos)
        
        local smoothness = math.clamp(Config.Aimbot.Smoothness, 1, 10)
        local alpha = math.clamp(dt * (11 - smoothness) * 6, 0.05, 1)
        Camera.CFrame = currentCFrame:Lerp(targetCFrame, alpha)
    else
        TargetHudFrame.Visible = false
    end
end))

