    lbl.BackgroundTransparency = 1
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextColor3 = TextWhite
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 13
    lbl.Text = text

    local btn = Instance.new("TextButton", base)
    btn.Size = UDim2.new(0, 34, 0, 18)
    btn.Position = UDim2.new(1, -44, 0.5, -9)
    btn.BackgroundColor3 = Config[configCat][configKey] and ThemeColor or Color3.fromRGB(60,60,60)
    btn.Text = ""
    Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)
    
    local knob = Instance.new("Frame", btn)
    knob.Size = UDim2.new(0, 14, 0, 14)
    knob.Position = Config[configCat][configKey] and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
    knob.BackgroundColor3 = Color3.fromRGB(255,255,255)
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    btn.MouseButton1Click:Connect(function()
        Config[configCat][configKey] = not Config[configCat][configKey]
        local state = Config[configCat][configKey]
        btn.BackgroundColor3 = state and ThemeColor or Color3.fromRGB(60,60,60)
        TweenService:Create(knob, TweenInfo.new(0.2), {Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)}):Play()
        Notify("Ajuste Cambiado", text .. " está ahora " .. (state and "Activado" or "Desactivado"))
    end)
end

local function CreateSlider(parent, text, configCat, configKey, min, max)
    local base = Instance.new("Frame")
    base.BackgroundColor3 = BgLight
    base.Parent = parent
    Instance.new("UICorner", base).CornerRadius = UDim.new(0, 6)
    
    local lbl = Instance.new("TextLabel", base)
    lbl.Size = UDim2.new(1, -10, 0, 20)
    lbl.Position = UDim2.new(0, 10, 0, 5)
    lbl.BackgroundTransparency = 1
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextColor3 = TextWhite
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 13
    lbl.Text = text

    local valLbl = Instance.new("TextLabel", base)
    valLbl.Size = UDim2.new(0, 40, 0, 20)
    valLbl.Position = UDim2.new(1, -50, 0, 5)
    valLbl.BackgroundTransparency = 1
    valLbl.TextXAlignment = Enum.TextXAlignment.Right
    valLbl.TextColor3 = ThemeColor
    valLbl.Font = Enum.Font.GothamBold
    valLbl.Text = tostring(Config[configCat][configKey])

    local track = Instance.new("TextButton", base)
    track.Size = UDim2.new(1, -20, 0, 6)
    track.Position = UDim2.new(0, 10, 0, 32)
    track.BackgroundColor3 = Color3.fromRGB(60,60,60)
    track.Text = ""
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
    
    local fill = Instance.new("Frame", track)
    local pct = (Config[configCat][configKey] - min) / (max - min)
    fill.Size = UDim2.new(pct, 0, 1, 0)
    fill.BackgroundColor3 = ThemeColor
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local dragging = false
    track.MouseButton1Down:Connect(function() dragging = true end)
    UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local mx = UserInputService:GetMouseLocation().X
            local rel = math.clamp(mx - track.AbsolutePosition.X, 0, track.AbsoluteSize.X)
            local pctNum = rel / track.AbsoluteSize.X
            fill.Size = UDim2.new(pctNum, 0, 1, 0)
            local value = math.floor(min + (pctNum * (max - min)))
            Config[configCat][configKey] = value
            valLbl.Text = tostring(value)
        end
    end)
end

