local function CreateSlider(parent, text, configCat, configKey, min, max)
    local base = Instance.new("Frame", parent)
    base.BackgroundColor3 = BgLight
    Instance.new("UICorner", base).CornerRadius = UDim.new(0, 6)
    
    local lbl = Instance.new("TextLabel", base)
    lbl.Size = UDim2.new(1, -10, 0, 15)
    lbl.Position = UDim2.new(0, 15, 0, 5)
    lbl.BackgroundTransparency = 1
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextColor3 = TextWhite
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 12
    lbl.Text = text

    local valLbl = Instance.new("TextLabel", base)
    valLbl.Size = UDim2.new(0, 40, 0, 15)
    valLbl.Position = UDim2.new(1, -50, 0, 5)
    valLbl.BackgroundTransparency = 1
    valLbl.TextXAlignment = Enum.TextXAlignment.Right
    valLbl.TextColor3 = ThemeColor
    valLbl.Font = Enum.Font.GothamBold
    valLbl.TextSize = 10
    valLbl.Text = tostring(Config[configCat][configKey])

    local track = Instance.new("TextButton", base)
    track.Size = UDim2.new(1, -30, 0, 4)
    track.Position = UDim2.new(0, 15, 0, 28)
    track.BackgroundColor3 = Color3.fromRGB(50,50,55)
    track.Text = ""
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
    
    local fill = Instance.new("Frame", track)
    local pct = (Config[configCat][configKey] - min) / (max - min)
    fill.Size = UDim2.new(pct, 0, 1, 0)
    fill.BackgroundColor3 = ThemeColor
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    -- Pelotita (Knob) añadida a la barra deslizante
    local sliderKnob = Instance.new("Frame", track)
    sliderKnob.Size = UDim2.new(0, 10, 0, 10)
    sliderKnob.Position = UDim2.new(pct, -5, 0.5, -5)
    sliderKnob.BackgroundColor3 = TextWhite
    Instance.new("UICorner", sliderKnob).CornerRadius = UDim.new(1, 0)

    local dragging = false
    track.MouseButton1Down:Connect(function() dragging = true end)
    UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local mx = UserInputService:GetMouseLocation().X
            local rel = math.clamp(mx - track.AbsolutePosition.X, 0, track.AbsoluteSize.X)
            local pctNum = rel / track.AbsoluteSize.X
            fill.Size = UDim2.new(pctNum, 0, 1, 0)
            sliderKnob.Position = UDim2.new(pctNum, -5, 0.5, -5)
            local value = math.floor(min + (pctNum * (max - min)))
            Config[configCat][configKey] = value
            valLbl.Text = tostring(value)
        end
    end)
end

