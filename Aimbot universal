-- 3. LÓGICA DEL SMART TEAM CHECK
-- ==========================================
local draggingSlider = false

local function IsTeammate(player)
    if not Settings.SmartTeamCheck then return false end
    if player == LocalPlayer then return true end

    -- A. Escudo de Protección / Spawn (ForceField)
    if Settings.IgnoreForceFields and player.Character then
        if player.Character:FindFirstChildOfClass("ForceField") then
            return true -- Se considera "intocable" temporalmente
        end
    end

    -- B. Mismo Equipo Directo
    if player.Team ~= nil and LocalPlayer.Team ~= nil then
        if player.Team == LocalPlayer.Team then
            return true
        end

        -- C. Comprobación de Alianzas Faccionales (Ejemplo: Policía + Ejército)
        local myTeamName = LocalPlayer.Team.Name
        local targetTeamName = player.Team.Name

        local myAlliance = FactionAlliances[myTeamName]
        local targetAlliance = FactionAlliances[targetTeamName]

        if myAlliance and targetAlliance and myAlliance == targetAlliance then
            return true -- Aliados por Facción (No se hacen daño)
        end
    end

    -- D. Comprobación por Color de Equipo (TeamColor)
    if player.TeamColor == LocalPlayer.TeamColor and player.TeamColor ~= BrickColor.new("White") then
        return true
    end

    return false
end

