CreateToggle(tabLocal, "Boost FPS (Limpiar Mapa)", "Local", "BoostFPS", function(state)
    if state then
        for _, v in pairs(workspace:GetDescendants()) do
            pcall(function()
                if v:IsA("BasePart") then
                    OriginalMaterials[v] = v.Material
                    v.Material = Enum.Material.SmoothPlastic
                elseif v:IsA("Decal") then
                    OriginalDecalTransparencies[v] = v.Transparency
                    v.Transparency = 1
                elseif v:IsA("Texture") then
                    OriginalTextureTransparencies[v] = v.Transparency
                    v.Transparency = 1
                end
            end)
        end
    else
        for part, mat in pairs(OriginalMaterials) do
            pcall(function() if part and part.Parent then part.Material = mat end end)
        end
        for decal, trans in pairs(OriginalDecalTransparencies) do
            pcall(function() if decal and decal.Parent then decal.Transparency = trans end end)
        end
        for tex, trans in pairs(OriginalTextureTransparencies) do
            pcall(function() if tex and tex.Parent then tex.Transparency = trans end end)
        end
    end
end)

