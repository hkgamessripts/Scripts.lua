ToggleStroke.Thickness = 1.5
ToggleStroke.Parent = ToggleBtn

-- ========== FUNCION PARA ACTIVAR PROMPT INSTANTANEAMENTE ==========

local function triggerPrompt(prompt)

    if not prompt or not prompt.Enabled then
        return
    end

    if triggeredPrompts[prompt] then
        return
    end

    triggeredPrompts[prompt] = true

    task.spawn(function()

        -- Guardar HoldDuration original y ponerlo en 0
        local originalHold = prompt.HoldDuration
        prompt.HoldDuration = 0

        -- Simular presion de E
        pcall(function()
            prompt:InputHoldBegin()
        end)

        task.wait(0.05)

        pcall(function()
            prompt:InputHoldEnd()
        end)

        -- Restaurar HoldDuration original
        task.wait(0.1)
        prompt.HoldDuration = originalHold

        -- Limpiar el debounce despues de un tiempo
        task.wait(1)
        triggeredPrompts[prompt] = nil

    end)
end

-- ========== DETECCION DE PROMPTS ==========

ProximityPromptService.PromptShown:Connect(function(prompt)

    if autoInteractEnabled then
        triggerPrompt(prompt)
    end

end)

ProximityPromptService.PromptHidden:Connect(function(prompt)

    triggeredPrompts[prompt] = nil

end)

-- ========== TOGGLE UI ==========

local function updateButtonVisual()

    if autoInteractEnabled then

        ToggleBtn.Text = "Auto E: ON"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(45, 160, 75)
        ToggleStroke.Color = Color3.fromRGB(80, 255, 120)

    else

        ToggleBtn.Text = "Auto E: OFF"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
        ToggleStroke.Color = Color3.fromRGB(80, 80, 90)

    end

end

ToggleBtn.MouseButton1Click:Connect(function()

    autoInteractEnabled = not autoInteractEnabled
    updateButtonVisual()

    if autoInteractEnabled then

        -- Disparar inmediatamente todos los prompts visibles actuales

        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")

        if hrp then

            for _, descendant in ipairs(workspace:GetDescendants()) do

                if descendant:IsA("ProximityPrompt") and descendant.Enabled then

                    local promptParent = descendant.Parent

                    if promptParent and promptParent:IsA("BasePart") then

                        local distance =
                            (hrp.Position - promptParent.Position).Magnitude

                        if distance <= descendant.MaxActivationDistance then
                            triggerPrompt(descendant)
                        end

                    end
                end

            end

        end

    else

        triggeredPrompts = {}

    end

end)

-- ========== TOGGLE CON TECLA RAPIDA (RightShift + E) ==========

UserInputService.InputBegan:Connect(function(input, gameProcessed)

    if gameProcessed then
        return
    end

    if input.KeyCode == Enum.KeyCode.E
        and UserInputService:IsKeyDown(Enum.KeyCode.RightShift) then

        autoInteractEnabled = not autoInteractEnabled
        updateButtonVisual()

    end

end)

updateButtonVisual()
