-- AUTO INTERACT - Interacciones rapidas automaticas (E)
-- Detecta ProximityPrompts y los activa instantaneamente cuando estan en rango
-- Mini interfaz para activar/desactivar el sistema

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer

-- ========== ESTADO ==========
local autoInteractEnabled = false
local triggeredPrompts = {} -- Track prompts ya activados para evitar spam

-- ========== GUI MINI ==========
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "AutoInteractUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.IgnoreGuiInset = true
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
ScreenGui.Parent = game:GetService("CoreGui")

-- Boton mini flotante (esquina inferior derecha)
local ToggleBtn = Instance.new("TextButton")
ToggleBtn.Size = UDim2.new(0, 160, 0, 40)
ToggleBtn.Position = UDim2.new(1, -175, 1, -50)
ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleBtn.Font = Enum.Font.GothamBold
ToggleBtn.TextSize = 13
ToggleBtn.Text = "Auto E: OFF"
ToggleBtn.Parent = ScreenGui

local ToggleCorner = Instance.new("UICorner")
ToggleCorner.CornerRadius = UDim.new(0, 8)
ToggleCorner.Parent = ToggleBtn

local ToggleStroke = Instance.new("UIStroke")
ToggleStroke.Color = Color3.fromRGB(80, 80, 90)
ToggleStroke.Thickness = 1.5
ToggleStroke.Parent = ToggleBtn

-- ========== FUNCION PARA ACTIVAR PROMPT INSTANTANEAMENTE ==========
local function triggerPrompt(prompt)
	if not prompt or not prompt.Enabled then return end
	if triggeredPrompts[prompt] then return end
	triggeredPrompts[prompt] = true

	task.spawn(function()
		-- Guardar HoldDuration original y ponerlo en 0 para activacion instantanea
		local originalHold = prompt.HoldDuration
		prompt.HoldDuration = 0

		-- Simular presion de E
		pcall(function()
			prompt:InputHoldBegin()
		end)
		task.wait(0.05)
		pcall(function()
			prompt:InputHoldEnd()
		end)

		-- Restaurar HoldDuration original
		task.wait(0.1)
		prompt.HoldDuration = originalHold

		-- Limpiar el debounce despues de un tiempo
		task.wait(1)
		triggeredPrompts[prompt] = nil
	end)
end

-- ========== DETECCION DE PROMPTS ==========
-- Cuando un prompt aparece en pantalla (el jugador esta en rango)
ProximityPromptService.PromptShown:Connect(function(prompt)
	if autoInteractEnabled then
		triggerPrompt(prompt)
	end
end)

-- Cuando un prompt desaparece, limpiar su debounce
ProximityPromptService.PromptHidden:Connect(function(prompt)
	triggeredPrompts[prompt] = nil
end)

-- ========== TOGGLE UI ==========
local function updateButtonVisual()
	if autoInteractEnabled then
		ToggleBtn.Text = "Auto E: ON"
		ToggleBtn.BackgroundColor3 = Color3.fromRGB(45, 160, 75)
		ToggleStroke.Color = Color3.fromRGB(80, 255, 120)
	else
		ToggleBtn.Text = "Auto E: OFF"
		ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
		ToggleStroke.Color = Color3.fromRGB(80, 80, 90)
	end
end

ToggleBtn.MouseButton1Click:Connect(function()
	autoInteractEnabled = not autoInteractEnabled
	updateButtonVisual()

	if autoInteractEnabled then
		-- Disparar inmediatamente todos los prompts visibles actuales
		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if hrp then
			for _, descendant in ipairs(workspace:GetDescendants()) do
				if descendant:IsA("ProximityPrompt") and descendant.Enabled then
					local promptParent = descendant.Parent
					if promptParent and promptParent:IsA("BasePart") then
						local distance = (hrp.Position - promptParent.Position).Magnitude
						if distance <= descendant.MaxActivationDistance then
							triggerPrompt(descendant)
						end
					end
				end
			end
		end
	else
		triggeredPrompts = {}
	end
end)

-- ========== TOGGLE CON TECLA RAPIDA (RightShift + E) ==========
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.E and UserInputService:IsKeyDown(Enum.KeyCode.RightShift) then
		autoInteractEnabled = not autoInteractEnabled
		updateButtonVisual()
	end
end)

updateButtonVisual()
