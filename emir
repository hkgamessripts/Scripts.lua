-- ========== FUNCIONES UI ==========
local function showStatus(msg, color)
    StatusLabel.Text = msg
    StatusLabel.TextColor3 = color or Color3.fromRGB(255, 255, 255)
    task.delay(3, function()
        if StatusLabel.Text == msg then StatusLabel.Text = "" end
    end)
end

-- ========== SISTEMA DE AUTOS ==========
local carButtons = {}
local orderCounter = 0

local function clearCarList()
    for _, btn in ipairs(carButtons) do
        if btn then btn:Destroy() end
    end
    carButtons = {}
    orderCounter = 0
end

local function getDriveSeat(car)
    if not car then return nil end
    return car:FindFirstChildOfClass("VehicleSeat")
end

local function isCarOccupied(car)
    local seat = getDriveSeat(car)
    if seat and seat.Occupant then
        return true
    end
    return false
end

local function waitForDriveSeat(car, timeout)
    local seat = car:FindFirstChildOfClass("VehicleSeat")
    if seat then return seat end

    local elapsed = 0
    while not seat and elapsed < (timeout or 10) do
        task.wait(0.1)
        elapsed = elapsed + 0.1
        seat = car:FindFirstChildOfClass("VehicleSeat")
    end
    return seat
end

local function teleportToCar(car)
    if isCarOccupied(car) then
        showStatus("Auto ocupado - No disponible", Color3.fromRGB(255, 100, 100))
        return
    end

    local char = LocalPlayer.Character
    if not char then
        showStatus("No tienes personaje", Color3.fromRGB(255, 100, 100))
        return
    end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then
        showStatus("Personaje no valido", Color3.fromRGB(255, 100, 100))
        return
    end

    showStatus("Teletransportando...", Color3.fromRGB(100, 200, 255))

    task.spawn(function()
        local success, carPos = pcall(function()
            return car:GetPivot().Position
        end)

        if not success or not carPos then
            showStatus("No se pudo obtener la posicion", Color3.fromRGB(255, 100, 100))
            return
        end

        pcall(function()
            LocalPlayer:RequestStreamAroundAsync(carPos, 15)
        end)

        local seat = waitForDriveSeat(car, 10)
        if not seat then
            showStatus("No se pudo cargar el auto", Color3.fromRGB(255, 100, 100))
            return
        end

        if seat.Occupant then
            showStatus("El auto esta ocupado", Color3.fromRGB(255, 100, 100))
            return
        end

        hrp.CFrame = seat.CFrame * CFrame.new(0, 3, 0)
        task.wait(0.3)
        seat:Sit(humanoid)

        showStatus("Subiste al auto!", Color3.fromRGB(100, 255, 100))
    end)
end

local function createCarButton(car)
    orderCounter = orderCounter + 1

    local owner = car:GetAttribute("Owner") or "Desconocido"
    local carType = car:GetAttribute("CarType") or "Auto"
    local locked = car:GetAttribute("Locked")
    local occupied = isCarOccupied(car)
    local seatExists = getDriveSeat(car) ~= nil

    local btn = Instance.new("Frame")
