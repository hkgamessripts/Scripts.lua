    nameLabel.Font = Enum.Font.GothamSemibold
    nameLabel.TextSize = 14
    nameLabel.TextXAlignment = Enum.TextXAlignment.Left
    nameLabel.Parent = btn

    local ownerLabel = Instance.new("TextLabel")
    ownerLabel.Size = UDim2.new(0.25, 0, 1, 0)
    ownerLabel.Position = UDim2.new(0.3, 0, 0, 0)
    ownerLabel.BackgroundTransparency = 1
    ownerLabel.Text = owner
    ownerLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    ownerLabel.Font = Enum.Font.Gotham
    ownerLabel.TextSize = 13
    ownerLabel.TextXAlignment = Enum.TextXAlignment.Left
    ownerLabel.Parent = btn

    local statusLabel = Instance.new("TextLabel")
    statusLabel.Size = UDim2.new(0.18, 0, 1, 0)
    statusLabel.Position = UDim2.new(0.55, 0, 0, 0)
    statusLabel.BackgroundTransparency = 1
    statusLabel.Font = Enum.Font.GothamBold
    statusLabel.TextSize = 11
    statusLabel.TextXAlignment = Enum.TextXAlignment.Left
    statusLabel.Parent = btn

    if occupied then
        statusLabel.Text = "OCUPADO"
        statusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
    elseif not seatExists then
        statusLabel.Text = "SIN CARGAR"
        statusLabel.TextColor3 = Color3.fromRGB(255, 180, 50)
    elseif locked then
        statusLabel.Text = "BLOQUEADO"
        statusLabel.TextColor3 = Color3.fromRGB(255, 180, 50)
    else
        statusLabel.Text = "LIBRE"
        statusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
    end

    local actionBtn = Instance.new("TextButton")
    actionBtn.Size = UDim2.new(0, 80, 0, 35)
    actionBtn.Position = UDim2.new(1, -88, 0.5, -17)
    actionBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    actionBtn.Font = Enum.Font.GothamBold
    actionBtn.TextSize = 13
    actionBtn.Parent = btn

    local actionCorner = Instance.new("UICorner")
    actionCorner.CornerRadius = UDim.new(0, 5)
    actionCorner.Parent = actionBtn

    if occupied then
        actionBtn.Text = "Ocupado"
        actionBtn.BackgroundColor3 = Color3.fromRGB(80, 40, 40)
        actionBtn.AutoButtonColor = false
    else
        actionBtn.Text = "Subir"
        actionBtn.BackgroundColor3 = Color3.fromRGB(45, 120, 200)
        actionBtn.MouseButton1Click:Connect(function()
            teleportToCar(car)
        end)
    end

    table.insert(carButtons, btn)
end

-- ========== REFRESCAR LISTA ==========
local function refreshList()
    clearCarList()

    local vehicles = Workspace:FindFirstChild("Vehicles")
    if not vehicles then
        showStatus("No hay autos en el juego", Color3.fromRGB(255, 100, 100))
        InfoLabel.Text = "Autos disponibles: 0"
        return
    end

    local count = 0
    for _, car in ipairs(vehicles:GetChildren()) do
        if car:IsA("Model") then
            createCarButton(car)
            count = count + 1
        end
    end

    InfoLabel.Text = "Autos disponibles: " .. count
    showStatus(count .. " autos encontrados", Color3.fromRGB(100, 255, 100))
end

