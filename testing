--====================================
-- UTILIDADES
--====================================

local function notify(title, text)
    game.StarterGui:SetCore("SendNotification", {
        Title = title,
        Text = text,
        Duration = 3
    })
end

local function getCharacter()
    return player.Character or player.CharacterAdded:Wait()
end

local function getHumanoid()
    local char = getCharacter()
    return char:FindFirstChildOfClass("Humanoid")
end

local function getHRP()
    local char = getCharacter()
    return char:FindFirstChild("HumanoidRootPart")
end

--====================================
-- REMOTE SCANNER
--====================================

local Remotes = {
    Damage = nil,
    Money = nil,
    Shoot = nil,
    Reload = nil
}

local function scanRemotes()
    notify("Scanner", "Buscando remotes...")
    
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local name = obj.Name:lower()
            
            if name:match("damage") or name:match("hit") or name:match("hurt") or name:match("attack") then
                Remotes.Damage = obj
                print("Damage remote:", obj.Name)
            end
            
            if name:match("money") or name:match("cash") or name:match("give") or name:match("add") then
                Remotes.Money = obj
                print("Money remote:", obj.Name)
            end
            
            if name:match("shoot") or name:match("fire") or name:match("gun") or name:match("weapon") then
                Remotes.Shoot = obj
                print("Shoot remote:", obj.Name)
            end
            
            if name:match("reload") or name:match("ammo") then
                Remotes.Reload = obj
                print("Reload remote:", obj.Name)
            end
        end
    end
    
    notify("Scanner", "Remotes encontrados!")
end

--====================================
-- GOD MODE
--====================================

local godModeConnection = nil

local function enableGodMode()
    if godModeConnection then godModeConnection:Disconnect() end
    
    local mt = getrawmetatable(game)
    setreadonly(mt, false)
    local oldNamecall = mt.__namecall
    
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        if method == "FireServer" or method == "InvokeServer" then
            local remoteName = self.Name:lower()
            if remoteName:match("damage") or remoteName:match("hit") or 
               remoteName:match("hurt") or remoteName:match("kill") or
               remoteName:match("attack") then
                return nil
            end
        end
        
        return oldNamecall(self, ...)
    end)
    
    setreadonly(mt, true)
    
    -- Loop de salud
    godModeConnection = RunService.Heartbeat:Connect(function()
        if not Config.GodMode then return end
        local humanoid = getHumanoid()
        if humanoid and humanoid.Health > 0 then
            humanoid.Health = humanoid.MaxHealth
            humanoid.MaxHealth = math.max(humanoid.MaxHealth, 100)
            humanoid.WalkSpeed = Config.WalkSpeed
            humanoid.JumpPower = Config.JumpPower
        end
    end)
end

--====================================
-- ESP / WALLHACK
--====================================

local ESPObjects = {}
local espConnection = nil

local function createESP(targetPlayer)
    if targetPlayer == player then return end
    
    local function setupCharacter(character)
        if not Config.ESP then return end
        
        local humanoid = character:WaitForChild("Humanoid")
        local head = character:WaitForChild("Head")
        local root = character:WaitForChild("HumanoidRootPart")
        
        -- Caja ESP
        local box = Instance.new("BoxHandleAdornment")
        box.Name = "SL_ESP_Box"
        box.Adornee = root
        box.AlwaysOnTop = true
        box.ZIndex = 10
        box.Size = Vector3.new(4, 6, 2)
        box.Transparency = 0.6
        
        -- Color según equipo
        if targetPlayer.Team then
            box.Color3 = targetPlayer.TeamColor.Color
        else
            box.Color3 = Color3.fromRGB(255, 0, 0)
        end
        
        box.Parent = root
        
        -- Nombre
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "SL_ESP_Name"
        billboard.Adornee = head
        billboard.Size = UDim2.new(0, 200, 0, 50)
        billboard.StudsOffset = Vector3.new(0, 2.5, 0)
        billboard.AlwaysOnTop = true
        
        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, 0, 1, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = targetPlayer.Name .. " | " .. math.floor(humanoid.Health) .. "HP"
        nameLabel.TextColor3 = box.Color3
        nameLabel.TextStrokeTransparency = 0
        nameLabel.TextSize = 14
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.Parent = billboard
        
        billboard.Parent = head
        
        -- Health bar
        local healthBar = Instance.new("BillboardGui")
        healthBar.Name = "SL_ESP_Health"
        healthBar.Adornee = root
        healthBar.Size = UDim2.new(0, 100, 0, 10)
        healthBar.StudsOffset = Vector3.new(0, 4, 0)
        healthBar.AlwaysOnTop = true
        
        local barBg = Instance.new("Frame")
        barBg.Size = UDim2.new(1, 0, 1, 0)
        barBg.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        barBg.BorderSizePixel = 0
        barBg.Parent = healthBar
        
        local barFill = Instance.new("Frame")
        barFill.Name = "Fill"
        barFill.Size = UDim2.new(humanoid.Health / humanoid.MaxHealth, 0, 1, 0)
        barFill.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
        barFill.BorderSizePixel = 0
        barFill.Parent = barBg
        
        healthBar.Parent = root
        
        -- Actualizar salud
        local healthConn = humanoid.HealthChanged:Connect(function()
            barFill.Size = UDim2.new(humanoid.Health / humanoid.MaxHealth, 0, 1, 0)
            nameLabel.Text = targetPlayer.Name .. " | " .. math.floor(humanoid.Health) .. "HP"
            barFill.BackgroundColor3 = Color3.fromRGB(
                255 * (1 - humanoid.Health / humanoid.MaxHealth),
                255 * (humanoid.Health / humanoid.MaxHealth),
                0
            )
        end)
        
        -- Limpiar al morir
        humanoid.Died:Connect(function()
            if box then box:Destroy() end
            if billboard then billboard:Destroy() end
            if healthBar then healthBar:Destroy() end
            if healthConn then healthConn:Disconnect() end
        end)
        
        table.insert(ESPObjects, {box, billboard, healthBar})
    end
    
    if targetPlayer.Character then
        setupCharacter(targetPlayer.Character)
    end
    
    targetPlayer.CharacterAdded:Connect(setupCharacter)
end

local function clearESP()
    for _, obj in ipairs(ESPObjects) do
        for _, part in ipairs(obj) do
            if part then part:Destroy() end
        end
    end
    ESPObjects = {}
end

local function initESP()
    clearESP()
    
    for _, plr in ipairs(Players:GetPlayers()) do
        createESP(plr)
    end
    
    Players.PlayerAdded:Connect(createESP)
    Players.PlayerRemoving:Connect(function(plr)
        -- Auto cleanup cuando se van
    end)
end

--====================================
-- KILL AURA
--====================================

local killAuraConnection = nil

local function getEnemiesInRange()
    local hrp = getHRP()
    if not hrp then return {} end
    
    local enemies = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            local enemyHRP = plr.Character:FindFirstChild("HumanoidRootPart")
            local humanoid = plr.Character:FindFirstChildOfClass("Humanoid")
            
            if enemyHRP and humanoid and humanoid.Health > 0 then
                local dist = (hrp.Position - enemyHRP.Position).Magnitude
                if dist <= Config.KillRange then
                    table.insert(enemies, {
                        Player = plr,
                        Character = plr.Character,
                        Humanoid = humanoid,
                        HRP = enemyHRP,
                        Distance = dist
                    })
                end
            end
        end
    end
    
    -- Ordenar por distancia
    table.sort(enemies, function(a, b) return a.Distance < b.Distance end)
    return enemies
end

local function enableKillAura()
    if killAuraConnection then killAuraConnection:Disconnect() end
    
    killAuraConnection = RunService.Heartbeat:Connect(function()
        if not Config.KillAura then return end
        
        local enemies = getEnemiesInRange()
        
        for _, enemy in ipairs(enemies) do
            -- Método 1: Remote del juego
            if Remotes.Damage then
                pcall(function()
                    Remotes.Damage:FireServer({
                        Target = enemy.Character,
                        Damage = 999999,
                        Headshot = true,
                        Position = enemy.HRP.Position
                    })
                end)
            end
            
            -- Método 2: Directo al humanoid
            pcall(function()
                enemy.Humanoid.Health = 0
            end)
            
            -- Método 3: FireTouch (si hay un objeto de daño)
            local tool = player.Character and player.Character:FindFirstChildOfClass("Tool")
            if tool then
                local handle = tool:FindFirstChild("Handle")
                if handle then
                    firetouchinterest(handle, enemy.HRP, 0)
                    firetouchinterest(handle, enemy.HRP, 1)
                end
            end
        end
    end)
end

