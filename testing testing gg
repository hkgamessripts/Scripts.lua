local function updateMoneyLabels()
    if Money then
        GlobalMoney.Text = "Cartera: $" .. formatNumber(Money.Value)
    end
end
if Money then
    Money.Changed:Connect(updateMoneyLabels)
    updateMoneyLabels()
end

local function showStatus(msg, color)
    StatusLabel.Text = msg
    StatusLabel.TextColor3 = color or Color3.fromRGB(255, 255, 255)
    task.delay(3, function()
        if StatusLabel.Text == msg then StatusLabel.Text = "Toggle UI: Right Shift" end
    end)
end

