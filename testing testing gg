local itemButtons = {}
local orderCounter = 0

local function clearItemList()
    for _, btn in ipairs(itemButtons) do btn:Destroy() end
    itemButtons = {}
    orderCounter = 0
end

local function createShopButton(itemName, displayName, price, category, remoteType)
    orderCounter = orderCounter + 1

    local btn = Instance.new("Frame")
    btn.Size = UDim2.new(1, 0, 0, 40)
    btn.BackgroundColor3 = Color3.fromRGB(25, 22, 30)
    btn.BorderSizePixel = 0
    btn.LayoutOrder = orderCounter
    btn.Parent = ScrollingFrame

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = btn

    local catLabel = Instance.new("TextLabel")
    catLabel.Size = UDim2.new(0, 65, 1, 0)
    catLabel.Position = UDim2.new(0, 4, 0, 0)
    catLabel.BackgroundTransparency = 1
    catLabel.Text = category
    catLabel.TextColor3 = (category == "MERC" and Color3.fromRGB(255, 150, 100)) or 
                          (category == "MASK" and Color3.fromRGB(200, 150, 255)) or 
                          Color3.fromRGB(100, 200, 255)
    catLabel.Font = Enum.Font.GothamBold
    catLabel.TextSize = 10
    catLabel.Parent = btn

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(0.4, 0, 1, 0)
    nameLabel.Position = UDim2.new(0.14, 0, 0, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = displayName
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.Font = Enum.Font.GothamSemibold
    nameLabel.TextSize = 13
    nameLabel.TextXAlignment = Enum.TextXAlignment.Left
    nameLabel.Parent = btn

    local priceLabel = Instance.new("TextLabel")
    priceLabel.Size = UDim2.new(0.2, 0, 1, 0)
    priceLabel.Position = UDim2.new(0.54, 0, 0, 0)
    priceLabel.BackgroundTransparency = 1
    priceLabel.Text = "$" .. formatNumber(price)
    priceLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
    priceLabel.Font = Enum.Font.GothamBold
    priceLabel.TextSize = 13
    priceLabel.TextXAlignment = Enum.TextXAlignment.Left
    priceLabel.Parent = btn

    local buyBtn = Instance.new("TextButton")
    buyBtn.Size = UDim2.new(0, 75, 0, 28)
    buyBtn.Position = UDim2.new(1, -83, 0.5, -14)
    buyBtn.BackgroundColor3 = Color3.fromRGB(140, 45, 45)
    buyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    buyBtn.Font = Enum.Font.GothamBold
    buyBtn.TextSize = 12
    buyBtn.Text = "Comprar"
    buyBtn.Parent = btn

    local buyCorner = Instance.new("UICorner")
    buyCorner.CornerRadius = UDim.new(0, 5)
    buyCorner.Parent = buyBtn

    buyBtn.MouseButton1Click:Connect(function()
        if remoteType == "Buy" and Buy then
            Buy:FireServer(itemName, price)
        elseif remoteType == "GunBuy" and GunBuy then
            GunBuy:FireServer(itemName)
        elseif remoteType == "BulletBuy" and BulletBuy then
            BulletBuy:FireServer(itemName)
        else
            showStatus("Error: Remote no disponible", Color3.fromRGB(255, 100, 100))
            return
        end
        showStatus("Comprando " .. displayName .. "...", Color3.fromRGB(100, 255, 100))
    end)

    table.insert(itemButtons, btn)
end

-- ========== CARGAR TODO EN EL PANEL ==========
local function loadAllModules()
    clearItemList()
    
    -- 1. Armas (Street Life)
    for _, item in ipairs(GUN_ITEMS) do
        createShopButton(item.name, item.display, item.price, "ARMAS", "GunBuy")
    end
    
    -- 2. Municiones (Street Life)
    for _, item in ipairs(AMMO_ITEMS) do
        createShopButton(item.name, item.display, item.price, "MUNICIÓN", "BulletBuy")
    end

    -- 3. Mercancia (Comerciante Ilegal)
    for _, item in ipairs(MERCHANT_ITEMS) do
        createShopButton(item.name, item.display, item.price, "MERC", "Buy")
    end

    -- 4. Mascaras (Comerciante Ilegal)
    for _, item in ipairs(MASK_ITEMS) do
        createShopButton(item.name, item.display, item.price, "MASK", "Buy")
    end

    showStatus("Módulos cargados correctamente", Color3.fromRGB(100, 255, 100))
    updateMoneyLabels()
end

-- ========== EVENTOS DE TECLADO Y CIERRE ==========
CloseBtn.MouseButton1Click:Connect(function()
    ScreenGui.Enabled = not ScreenGui.Enabled
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        ScreenGui.Enabled = not ScreenGui.Enabled
        if ScreenGui.Enabled then
            loadAllModules()
        end
    end
end)

-- Inicializar carga por primera vez
loadAllModules()
