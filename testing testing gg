local function formatNumber(n)
    n = tonumber(n) or 0
    local formatted = tostring(math.floor(n))
    while true do
        local s, count = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1,%2")
        if count == 0 then break end
        formatted = s
    end
    return formatted
end

