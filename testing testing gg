-- ========== UTILIDADES ==========
local function formatNumber(n)
    n = tonumber(n) or 0
    local s = tostring(math.floor(n))
    while true do
        local r, c = string.gsub(s, "^(-?%d+)(%d%d%d)", "%1,%2")
        if c == 0 then break end
        s = r
    end
    return s
end

