local function scanCacheForType(scrollingFrame, isBullet)
    local cacheName = isBullet and "RemoteBulletData" or "RemoteWeaponData"
    local cache = ReplicatedStorage:FindFirstChild(cacheName)
    if not cache and isBullet then
        cache = ReplicatedStorage:FindFirstChild("RemoteWeaponData")
    end
    if not cache then return 0 end
    
    local children = cache:GetChildren()
    if #children == 0 then return 0 end
    
    table.sort(children, function(a, b) return a.Name < b.Name end)
    
    local count = 0
    local tracker = isBullet and scannedItems.Bullets or scannedItems.Weapons
    
    for _, entry in ipairs(children) do
        if entry:IsA("IntValue") then
            local name = entry.Name
            local isAmmo = isAmmoItem(name)
            local match = (isBullet and isAmmo) or (not isBullet and not isAmmo)
            if cacheName == "RemoteWeaponData" and isBullet then
                match = isAmmo
            elseif cacheName == "RemoteWeaponData" and not isBullet then
                match = not isAmmo
            end

            if match and not tracker[name] then
                tracker[name] = true
                createItemButton(scrollingFrame, name, entry.Value, isBullet)
                count = count + 1
            end
        end
    end
    return count
end

local function scanWall(wall, scrollingFrame, isBullet)
    local count = 0
    local tracker = isBullet and scannedItems.Bullets or scannedItems.Weapons
    for _, slot in ipairs(wall:GetChildren()) do
        local tool = slot:FindFirstChild("Tool")
        local price = slot:FindFirstChild("Price")
        if tool and price then
            local name = tool.Value
            local cost = price.Value
            if name and name ~= "" then
                local isAmmo = isAmmoItem(name)
                if (isBullet and isAmmo) or (not isBullet and not isAmmo) then
                    if not tracker[name] then
                        tracker[name] = true
                        createItemButton(scrollingFrame, name, cost, isBullet)
                        count = count + 1
                    end
                end
            end
        end
    end
    return count
end

local function scanStreamingForType(scrollingFrame, isBullet)
    local map = workspace:FindFirstChild("Map")
    if not map then return 0 end
    
    local found = 0
    for _, gsName in ipairs({"GunStore", "GunStore2"}) do
        local gs = map:FindFirstChild(gsName)
        if gs then
            local wall = gs:FindFirstChild("Wall")
            local gwall = gs:FindFirstChild("GWall")
            if wall then found = found + scanWall(wall, scrollingFrame, isBullet) end
            if gwall then found = found + scanWall(gwall, scrollingFrame, isBullet) end
        end
    end
    return found
end

local function scanStore(scrollingFrame, isBullet)
    local typeName = isBullet and "Balas" or "Armas"
    scannedItems[isBullet and "Bullets" or "Weapons"] = {}
    clearList(isBullet)
    
    local found = scanCacheForType(scrollingFrame, isBullet)
    if found == 0 then
        local gunStorePositions = {}
        local track = workspace:FindFirstChild("POI") and workspace.POI:FindFirstChild("Track")
        if track then
            local gs1 = track:FindFirstChild("GunStore")
            if gs1 and gs1:IsA("BasePart") then table.insert(gunStorePositions, gs1.Position) end
            local gs2 = track:FindFirstChild("GunStore2")
            if gs2 and gs2:IsA("BasePart") then table.insert(gunStorePositions, gs2.Position) end
        end
        
        for _, pos in ipairs(gunStorePositions) do
            pcall(function() LocalPlayer:RequestStreamAroundAsync(pos, 10) end)
        end
        
        task.wait(1.5)
        found = scanStreamingForType(scrollingFrame, isBullet)
        if found == 0 then
            for i = 1, 3 do
                task.wait(1)
                found = scanStreamingForType(scrollingFrame, isBullet)
                if found > 0 then break end
            end
        end
        if found == 0 then
            found = scanCacheForType(scrollingFrame, isBullet)
        end
    end
    
    if found > 0 then
        Notify("Street Life", found .. " " .. typeName .. " cargadas.")
    else
        Notify("Street Life", "No se encontraron " .. typeName .. ".")
    end
end

